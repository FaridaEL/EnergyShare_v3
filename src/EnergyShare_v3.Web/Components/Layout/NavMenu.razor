                <NavLink class="nav-link"
                         href="/organisme-public/demandes-grd">
                    <span class="bi bi-file-earmark-check" aria-hidden="true"></span>
                    <span>Validations partage</span>
                </NavLink>
            </div>



        </Authorized>
