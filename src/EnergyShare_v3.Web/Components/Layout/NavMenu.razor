<!-- ========================= -->
<!-- LOGO / BRANDING SIDEBAR   -->
<!-- ========================= -->
<div class="sidebar-logo">
    <div class="brand-block">
        <img src="images/logo-energyshare.png"
             alt="Logo EnergyShare"
             class="nav-logo" />

        <span class="brand-name">EnergyShare</span>
    </div>
</div>

<!-- ========================= -->
<!-- MENU DE NAVIGATION        -->
<!-- ========================= -->
<nav class="nav flex-column">

    <!-- Accueil -->
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="bi bi-house-door-fill" aria-hidden="true"></span>
            <span>Home</span>
        </NavLink>
    </div>

    <!-- ========================= -->
    <!-- SECTION : MON ESPACE USER -->
    <!-- ========================= -->
    <AuthorizeView>
        <Authorized>
            <div class="nav-section-title">Mes données</div>

            <!-- Mon profil utilisateur -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="mon-profil">
                    <span class="bi bi-person-fill" aria-hidden="true"></span>
                    <span>Mon profil</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <!-- ========================= -->
    <!-- SECTION : UTILISATEUR     -->
    <!-- ========================= -->
    <AuthorizeView Roles="Utilisateur">
        <Authorized>

            <!-- Mes points d'accès -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="mes-points-access">
                    <span class="bi bi-geo-alt-fill" aria-hidden="true"></span>
                    <span>Mes points d'accès</span>
                </NavLink>
            </div>

            <!-- Mon profil énergie -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="profil-energie">
                    <span class="bi bi-lightning-charge-fill" aria-hidden="true"></span>
                    <span>Mon profil énergie</span>
                </NavLink>
            </div>

            <!-- ========================= -->
            <!-- SOUS-SECTION : MATCHING   -->
            <!-- ========================= -->
            <div class="nav-section-title">Matching</div>

            <!-- Trouver un match -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="matching/search">
                    <span class="bi bi-search" aria-hidden="true"></span>
                    <span>Trouver un match</span>
                </NavLink>
            </div>

            <!-- Mes matchs -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="matching/my">
                    <span class="bi bi-people-fill" aria-hidden="true"></span>
                    <span>Mes matchs</span>
                </NavLink>
            </div>


            <!-- Mes messages -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="messages/">
                    <span class="bi bi-envelope-fill" aria-hidden="true"></span>
                    <span>Mes messages</span>
                </NavLink>
            </div>

            <!-- ========================= -->
            <!-- SOUS-SECTION : Partage   -->
            <!-- ========================= -->
            <div class="nav-section-title">Partage</div>

            <!-- Mon partage -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="partages/my">
                    <span class="bi bi-arrow-left-right" aria-hidden="true"></span>
                    <span>Mon partage</span>
                </NavLink>
            </div>

            <!-- Créer partage -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="partages/create">
                    <span class="bi bi-plus-circle-fill" aria-hidden="true"></span>
                    <span>Créer un partage</span>
                </NavLink>
            </div>

            <!-- Rejoindre partage -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="partages/rejoindre">
                    <span class="bi bi-person-plus-fill" aria-hidden="true"></span>
                    <span>Rejoindre un partage</span>
                </NavLink>
            </div>

        </Authorized>
    </AuthorizeView>

    <!-- ========================= -->
    <!-- SECTION : ADMIN           -->
    <!-- ========================= -->
    <AuthorizeView Roles="Administrateur">
        <Authorized>

            <div class="nav-section-title">Administration</div>

            <!-- Gestion des utilisateurs -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="users">
                    <span class="bi bi-people-fill" aria-hidden="true"></span>
                    <span>Utilisateurs</span>
                </NavLink>
            </div>

        </Authorized>
    </AuthorizeView>

    <!-- ========================= -->
    <!-- SECTION : ORGANISME PUBLIC / GRD -->
    <!-- ========================= -->
    <AuthorizeView Roles="OrganismePublic">
        <Authorized>

            <div class="nav-section-title">Organisme public</div>

            <!-- Demandes d'information de périmètre -->
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="organisme-public/demandes-grd">
                    <span class="bi bi-clipboard-check" aria-hidden="true"></span>
                    <span>Demandes périmètre</span>
                </NavLink>
            </div>

            <!-- Todo Plus tard : demandes de validation de nouveaux partages -->
