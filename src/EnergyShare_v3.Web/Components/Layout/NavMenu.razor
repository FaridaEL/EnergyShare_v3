@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">EnergyShare_v3.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
            
        </div>
        <!-- mon profil user -->
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="mon-profil">
                        
                            Mon profil utilisateur
                        </NavLink>
                   
                </div>
            </Authorized>
        </AuthorizeView>
        
        <AuthorizeView Roles="Utilisateur">
            <Authorized>
                <!-- mes points accès -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="mes-points-access">
                        Mes points d'accès
                    </NavLink>
                </div>
                <!-- mon profil énergie -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="profil-energie">
                        Mon profil énergie
                    </NavLink>
                </div>

                <!-- trouver un match -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="matching/search">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Trouver un match
                    </NavLink>
                </div>

                   <!-- mes matchs -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="matching/my">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Mes matchs
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        
        
        <!-- Admin only : liste des users -->
        
        <AuthorizeView Roles="Administrateur">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="users">
                        <span class="bi bi-people-fill" aria-hidden="true"></span> Users
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

    </nav>
</div>

