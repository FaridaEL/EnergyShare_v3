@page "/concept-partage-energie"

<PageTitle>Découvrir le partage d’énergie</PageTitle>

<div class="concept-page">
    <section class="concept-hero">
        <div class="row align-items-center">

            <!-- TEXTE -->
            <div class="col-lg-8">
                <span class="badge rounded-pill bg-warning text-dark mb-3">
                    Comprendre le partage d’énergie
                </span>

                <h1>Le partage d’énergie à Bruxelles, simplement</h1>

                <p class="lead">
                    Le partage d’énergie permet à un citoyen qui produit de l’énergie renouvelable
                    de valoriser son surplus auprès d’un autre citoyen proche, tout en favorisant
                    une consommation locale, durable et transparente.
                </p>

                <a href="/" class="btn btn-outline-primary mt-3">
                    Retour à l’accueil
                </a>
            </div>

            <!-- LOGO -->
            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                <div class="concept-logo-container">
                    <img src="images/logo-energyshare.png"
                         alt="EnergyShare"
                         class="concept-logo" />
                </div>
            </div>

        </div>
    </section>


   @*  <section class="concept-hero">
        <span class="badge rounded-pill bg-warning text-dark mb-3">
            Comprendre le partage d’énergie
        </span>

        <h1>Le partage d’énergie à Bruxelles, simplement</h1>

        <p class="lead">
            Le partage d’énergie permet à un citoyen qui produit de l’énergie renouvelable
            de valoriser son surplus auprès d’un autre citoyen proche, tout en favorisant
            une consommation locale, durable et transparente.
        </p>

        <a href="/" class="btn btn-outline-primary mt-3">
