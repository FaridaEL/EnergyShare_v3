@page "/messages/send"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Mediator
@using EnergyShare_v3.Application.Features.Messages

@inject ISender Sender
@inject NavigationManager Navigation

<PageTitle>Envoyer un message</PageTitle>

<div class="page-shell py-4">
    <div class="mb-4">
        <h2 class="page-title mb-1">Envoyer un message</h2>
        <p class="page-subtitle mb-0">
            Contactez directement un utilisateur depuis un match.
        </p>
    </div>
   

    <div class="card responsive-card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body">

            <div class="d-flex align-items-center gap-2 mb-4">
                <span class="bi bi-envelope-fill"></span>
                <h5 class="fw-bold mb-0">Nouveau message</h5>
            </div>

            <div class="row g-3">

                <div class="col-lg-6">
                    <label class="form-label fw-semibold">
                        Destinataire
                    </label>

                    <input class="form-control"
                           value="@DestinataireDisplayName"
                           disabled />
                </div>

                <div class="col-lg-6">
                    <label class="form-label fw-semibold">
                        Objet
                    </label>

                    <input class="form-control"
                           @bind="NewMessage.ObjetMessage" />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">
                        Message
                    </label>

                    <textarea class="form-control"
                              rows="6"
                              @bind="NewMessage.Contenu">
                    </textarea>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">

                   
                    <button class="btn btn-energy-action"
                            @onclick="SendMessageAsync">
                        <span class="bi bi-send-fill me-1"></span>
                        Envoyer
                    </button>

                    <a href="/messages"
                       class="btn btn-energy-cancel">
                        <span class="bi bi-x-lg me-1"></span>
                        Annuler
                    </a>

                </div>

            </div>
        </div>
    </div>
</div>


@code {
    private List<MessageDto> Inbox { get; set; } = [];
    private List<MessageDto> Outbox { get; set; } = [];

    private bool IsLoading { get; set; } = true;
    private string ActiveTab { get; set; } = "inbox";
    private string? AlertMessage { get; set; }

    private NewMessageForm NewMessage { get; set; } = new();
    private string DestinataireDisplayName { get; set; } = "Utilisateur sélectionné";

  
    protected override Task OnInitializedAsync()
    {
        ReadQueryString();
        IsLoading = false;
        return Task.CompletedTask;
    }

    private void ReadQueryString()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("prenom", out var prenom))
        {
            DestinataireDisplayName = prenom!;
        }

        if (query.TryGetValue("to", out var to))
            NewMessage.DestinataireIdText = to!;

        if (query.TryGetValue("matchId", out var matchId))
            NewMessage.MatchIdText = matchId!;

        if (query.TryGetValue("subject", out var subject))
        {
            NewMessage.ObjetMessage = subject!;
            NewMessage.Contenu = "";
            return;
        }
        if (!string.IsNullOrWhiteSpace(NewMessage.DestinataireIdText))
        {
            NewMessage.ObjetMessage = "Contact depuis un match EnergyShare";
            NewMessage.Contenu = "Bonjour, je suis intéressé(e) par votre profil énergétique.";
        }
    }


    private async Task SendMessageAsync()
    {
        AlertMessage = null;

        if (!Guid.TryParse(NewMessage.DestinataireIdText, out var destinataireId))
        {
            AlertMessage = "Le destinataire est invalide.";
            return;
        }

        Guid? matchId = null;

        if (!string.IsNullOrWhiteSpace(NewMessage.MatchIdText)
            && Guid.TryParse(NewMessage.MatchIdText, out var parsedMatchId))
        {
            matchId = parsedMatchId;
        }

        var result = await Sender.Send(new SendMessage(
            destinataireId,
            NewMessage.ObjetMessage,
            NewMessage.Contenu,
            matchId));

        if (!result.IsSuccess)
        {
            AlertMessage = "Impossible d’envoyer le message.";
            return;
        }

        AlertMessage = "Message envoyé.";
        Navigation.NavigateTo("/messages");
        NewMessage = new();
        // await LoadMessagesAsync();
        ActiveTab = "outbox";
    }


    private class NewMessageForm
    {
        public string DestinataireIdText { get; set; } = "";
        public string ObjetMessage { get; set; } = "";
        public string Contenu { get; set; } = "";
        public string? MatchIdText { get; set; }
    }
}