@page "/messages"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Mediator
@using EnergyShare_v3.Application.Features.Messages

@inject ISender Sender
@inject NavigationManager Navigation

<PageTitle>Mes messages</PageTitle>

<div class="page-shell py-4">
    <div class="mb-4">
        <h2 class="page-title mb-1">Mes messages</h2>
        <p class="page-subtitle mb-0">
            Consultez vos échanges avec vos matchs.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(AlertMessage))
    {
        <div class="alert alert-info rounded-4">@AlertMessage</div>
    }

    <!-- Onglets Bootstrap : on affiche soit les messages reçus, soit les messages envoyés -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "inbox" ? "active" : "")"
                    @onclick='() => ActiveTab = "inbox"'>
                Reçus (@Inbox.Count)
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "outbox" ? "active" : "")"
                    @onclick='() => ActiveTab = "outbox"'>
                Envoyés (@Outbox.Count)
            </button>
        </li>
    </ul>




    @if (IsLoading)
    {
        <p>Chargement...</p>
    }
    else
    {
        var messages = ActiveTab == "inbox" ? Inbox : Outbox;
        var isInbox = ActiveTab == "inbox";
        var filteredMessages = GetFilteredMessages(messages, isInbox).ToList();

        @if (messages.Count == 0)
        {
            <div class="alert alert-info rounded-4">
                Aucun message à afficher.
            </div>
        }
        else
        {
            @* =========================================================
       FILTRES DES MESSAGES
       ========================================================= *@

            <div class="matches-filter-panel mb-4">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-5">
                        <label class="form-label fw-semibold">
                            Rechercher
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <span class="bi bi-search"></span>
                            </span>

                            <input class="form-control"
                                   placeholder="Contact, objet ou contenu..."
                                   @bind="messageSearchText"
                                   @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="col-lg-2">
                        <label class="form-label fw-semibold">
                            Statut
                        </label>

                        <select class="form-select"
                                @bind="messageReadFilter">
                            <option value="all">Tous</option>
                            <option value="read">Lu</option>
                            <option value="unread">Non lu</option>
                        </select>
                    </div>

                    <div class="col-lg-2">
                        <label class="form-label fw-semibold">
                            Du
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="dateFrom" />
                    </div>

                    <div class="col-lg-2">
                        <label class="form-label fw-semibold">
                            Au
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="dateTo" />
                    </div>

                    <div class="col-lg-1">
                        <button class="btn btn-energy-cancel w-100"
                                type="button"
                                title="Réinitialiser les filtres"
                                @onclick="ResetMessageFilters">
                            <span class="bi bi-arrow-counterclockwise"></span>
                        </button>
                    </div>

                </div>

            </div>


            @if (filteredMessages.Count == 0)
            {
                <div class="alert alert-info rounded-4">
                    Aucun message ne correspond aux critères sélectionnés.
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body">

                        <div class="table-responsive">
                            <table class="table align-middle responsive-table messages-table">

                                <thead>
                                    <tr>
                                        <th class="message-date">Date</th>
                                        <th>Type</th>
                                        <th class="message-object">Objet</th>
                                        <th class="message-content">Contenu</th>
                                        <th>Contact</th>
                                        <th>Statut</th>

                                        @if (isInbox)
                                        {
                                            <th class="message-actions">Actions</th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var message in filteredMessages)
                                    {
                                        <tr>

                                            <td class="message-date">
                                                @message.DateEnvoi.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </td>

                                            <td>
                                                @if (isInbox)
                                                {
                                                    <span class="badge bg-primary">IN</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">OUT</span>
                                                }
                                            </td>

                                            <td class="message-object">
                                                @message.ObjetMessage
                                            </td>

                                            <td class="message-content">
                                                @message.Contenu
                                            </td>

                                            <td>
                                                @(isInbox
                                                    ? message.NomExpediteur
                                                    : message.NomDestinataire)
                                            </td>

                                            <td>
                                                @if (message.IsLu)
                                                {
                                                    <span class="badge bg-success">Lu</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Non lu
                                                    </span>
                                                }
                                            </td>

                                            @if (isInbox)
                                            {
                                                <td class="message-actions">

                                                    <button class="btn btn-energy-action btn-sm message-reply-btn"
                                                            @onclick="() => ReplyTo(message)">
                                                        <span class="bi bi-reply-fill me-1"></span>
                                                        Répondre
                                                    </button>

                                                    @if (!message.IsLu)
                                                    {
                                                        <button class="btn btn-energy-cancel btn-sm"
                                                                @onclick="() => MarkAsReadAsync(message.Id)">
                                                            <span class="bi bi-check2 me-1"></span>
                                                            Marquer lu
                                                        </button>
                                                    }

                                                </td>
                                            }

                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>

                    </div>
                </div>
            }
        }
    }
</div>

@code {
    private List<MessageDto> Inbox { get; set; } = [];
    private List<MessageDto> Outbox { get; set; } = [];

    private bool IsLoading { get; set; } = true;
    private string ActiveTab { get; set; } = "inbox";
    private string? AlertMessage { get; set; }

    // =========================================================
    // FILTRES DES MESSAGES
    // =========================================================

    // Recherche libre : contact, objet ou contenu.
    private string messageSearchText = string.Empty;

    // all = tous
    // read = lus
    // unread = non lus
    private string messageReadFilter = "all";

    // Période de recherche.
    private DateTime? dateFrom;
    private DateTime? dateTo;

    /// <summary>
    /// Retourne les messages correspondant aux filtres sélectionnés.
    /// Le contact recherché dépend de l'onglet actif :
    /// - reçus  -> expéditeur ;
    /// - envoyés -> destinataire.
    /// </summary>
    
    private IEnumerable<MessageDto> GetFilteredMessages(
        IEnumerable<MessageDto> messages, bool isInbox)
    {
        var query = messages;

        // Recherche libre sur contact, objet et contenu.
        if (!string.IsNullOrWhiteSpace(messageSearchText))
        {
            query = query.Where(message =>
            {
                var contact = isInbox
                    ? message.NomExpediteur
                    : message.NomDestinataire;

                return
                    (!string.IsNullOrWhiteSpace(contact)
                     && contact.Contains( messageSearchText,StringComparison.OrdinalIgnoreCase))
                    || (!string.IsNullOrWhiteSpace(message.ObjetMessage)
                        && message.ObjetMessage.Contains( messageSearchText,StringComparison.OrdinalIgnoreCase))
                    || (!string.IsNullOrWhiteSpace(message.Contenu)
                     && message.Contenu.Contains( messageSearchText, StringComparison.OrdinalIgnoreCase));
            });
        }

        // Filtre lu / non lu.
        if (messageReadFilter == "read")
        {
            query = query.Where(message => message.IsLu);
        }
        else if (messageReadFilter == "unread")
        {
            query = query.Where(message => !message.IsLu);
        }

        // Date de début incluse.
        if (dateFrom.HasValue)
        {
            query = query.Where(message =>
                message.DateEnvoi.ToLocalTime().Date >= dateFrom.Value.Date);
        }

        // Date de fin incluse.
        if (dateTo.HasValue)
        {
            query = query.Where(message =>
                message.DateEnvoi.ToLocalTime().Date <= dateTo.Value.Date);
        }

        return query;
    }

    private void ResetMessageFilters()
    {
        messageSearchText = string.Empty;
        messageReadFilter = "all";
        dateFrom = null;
        dateTo = null;
    }

    // =========================================================
    // FILTRES DES MESSAGES        Fin
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadMessagesAsync();
    }

    // Charge les messages reçus et envoyés depuis les handlers Application
    private async Task LoadMessagesAsync()
    {
        IsLoading = true;

        var inboxResult = await Sender.Send(new GetInboxMessages());
        var outboxResult = await Sender.Send(new GetSentMessages());

        Inbox = inboxResult.IsSuccess ? inboxResult.Value.ToList() : [];
        Outbox = outboxResult.IsSuccess ? outboxResult.Value.ToList() : [];

        IsLoading = false;
    }

    // Marque un message reçu comme lu, puis recharge la liste
    private async Task MarkAsReadAsync(Guid messageId)
    {
        var result = await Sender.Send(new MarkMessageAsRead(messageId));

        if (!result.IsSuccess)
        {
            AlertMessage = "Impossible de marquer ce message comme lu.";
            return;
        }

        await LoadMessagesAsync();
    }

    // Redirige vers la page d'envoi avec le destinataire et l'objet préremplis
    private void ReplyTo(MessageDto message)
    {
        var prenom = string.IsNullOrWhiteSpace(message.NomExpediteur)
            ? "Utilisateur sélectionné"
            : message.NomExpediteur;

        var url =
            $"/messages/send?to={message.ExpediteurId}" +
            $"&prenom={Uri.EscapeDataString(prenom)}" +
            $"&subject={Uri.EscapeDataString($"RE: {message.ObjetMessage}")}" +
            (message.MatchId is not null ? $"&matchId={message.MatchId}" : "");

        Navigation.NavigateTo(url);
    }
}