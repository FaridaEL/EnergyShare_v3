    private async Task MarkAsReadAsync(Guid messageId)
    {
        var result = await Sender.Send(new MarkMessageAsRead(messageId));

        if (!result.IsSuccess)
        {
            AlertMessage = "Impossible de marquer ce message comme lu.";
            return;
        }

        await LoadMessagesAsync();
    }

    private void ReplyTo(MessageDto message)
    {
        // NewMessage.DestinataireIdText = message.ExpediteurId.ToString();
        // NewMessage.ObjetMessage = $"RE: {message.ObjetMessage}";
        // NewMessage.Contenu = "";
        // NewMessage.MatchIdText = message.MatchId?.ToString();
        Navigation.NavigateTo(
         $"/messages/send?to={message.ExpediteurId}&matchId={message.MatchId}&subject={Uri.EscapeDataString($"RE: {message.ObjetMessage}")}");
    }

    private RenderFragment RenderMessagesTable(List<MessageDto> messages, bool isInbox) => builder =>
    {
        if (messages.Count == 0)
        {
            builder.AddMarkupContent(0, """
                <div class="alert alert-info rounded-4">
                    Aucun message à afficher.
                </div>
            """);
            return;
        }

        builder.OpenElement(1, "div");
        builder.AddAttribute(2, "class", "card shadow-sm border-0 rounded-4");

        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", "card-body table-responsive");

        builder.OpenElement(5, "table");
        builder.AddAttribute(6, "class", "table align-middle");

        builder.AddMarkupContent(7, """
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Objet</th>
                    <th>Contenu</th>
                    <th>Contact</th>
                    <th>Statut</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
        """);

        builder.OpenElement(8, "tbody");

        var sequence = 9;

        foreach (var message in messages)
        {
            builder.OpenElement(sequence++, "tr");

            builder.OpenElement(sequence++, "td");
            builder.AddContent(sequence++, message.DateEnvoi.ToLocalTime().ToString("dd/MM/yyyy HH:mm"));
            builder.CloseElement();

            builder.OpenElement(sequence++, "td");
            builder.AddMarkupContent(sequence++, isInbox
                ? "<span class=\"badge bg-primary\">IN</span>"
                : "<span class=\"badge bg-secondary\">OUT</span>");
            builder.CloseElement();

            builder.OpenElement(sequence++, "td");
            builder.AddContent(sequence++, message.ObjetMessage);
            builder.CloseElement();

            builder.OpenElement(sequence++, "td");
            builder.AddContent(sequence++, message.Contenu);
            builder.CloseElement();

            builder.OpenElement(sequence++, "td");
            builder.AddContent(sequence++, isInbox ? message.NomExpediteur : message.NomDestinataire);
            builder.CloseElement();

            builder.OpenElement(sequence++, "td");
            builder.AddMarkupContent(sequence++, message.IsLu
                ? "<span class=\"badge bg-success\">Lu</span>"
                : "<span class=\"badge bg-warning text-dark\">Non lu</span>");
            builder.CloseElement();

            builder.OpenElement(sequence++, "td");
            builder.AddAttribute(sequence++, "class", "text-end");

            if (isInbox)
            {
                builder.OpenElement(sequence++, "button");
                builder.AddAttribute(sequence++, "class", "btn btn-outline-primary btn-sm rounded-pill me-2");
                builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => ReplyTo(message)));
                builder.AddContent(sequence++, "Répondre");
                builder.CloseElement();

                if (!message.IsLu)
                {
                    builder.OpenElement(sequence++, "button");
                    builder.AddAttribute(sequence++, "class", "btn btn-outline-success btn-sm rounded-pill");
                    builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => MarkAsReadAsync(message.Id)));
                    builder.AddContent(sequence++, "Marquer lu");
                    builder.CloseElement();
                }
            }

            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

