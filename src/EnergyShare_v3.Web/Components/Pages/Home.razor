@page "/"

<PageTitle>EnergyShare - Accueil </PageTitle>

<h1>Bienvenur sur EnergyShare</h1>

<p class="lead">
    L'application qui vous permet de vendre votre énergie durable et locale en toute simplicité à Bruxelles.
</p>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Partage</h5>
                <p class="card-text">
                    Gerez votre partage d'énergie.
                </p>
                <a href="/Users" class="btn btn-primary">Voir les utilisateurs</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">ACompleter</h5>
                <p class="card-text">
                    Creez et assignez des taches menageres aux membres.
                </p>
                <a href="/Users" class="btn btn-primary">Gerer les taches</a>
            </div>
        </div>
    </div>
</div>
