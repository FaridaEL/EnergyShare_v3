@page "/users"
@using EnergyShare_v3.Application.Features.Users
@using Microsoft.AspNetCore.Authorization
@using Mediator
@attribute [Authorize(Roles = "Administrateur")]

@inject GetUsersHandler UsersHandler
@inject ISender Sender

<PageTitle>EnergyShare - Utilisateurs</PageTitle>

<h1>Utilisateurs</h1>

@if (_users is null)
{
    <p>Chargement...</p>
}
else
{
    <ul>
        @foreach (var user in _users)
        {
            <li>@user.FirstName @user.LastName - @user.Email</li>
        }
    </ul>
}

@code {
    private IReadOnlyList<UserSummaryDto>? _users;

    protected override async Task OnInitializedAsync()
    {
        var result = await Sender.Send(new GetUsersQuery());

        if (result.IsSuccess)
        {
            _users = result.Value;
        }
        else
        {
            _users = [];
        }
    }
}