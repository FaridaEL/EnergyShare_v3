@page "/mon-profil"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using EnergyShare_v3.Application.Features.Users
@using EnergyShare_v3.Web.Models.User
@using Mediator

@inject ISender Sender

<PageTitle>Mon profil utilisateur </PageTitle>

<h3>Mon profil</h3>

@if (isLoading)
{
    <p>Chargement...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning">@errorMessage</div>
}
else if (profile is not null)
{
    @if (!isEditMode)
    {
        <div class="profile-section">

            <div class="profile-section-header">
                <span class="bi bi-person-fill"></span>
                <span>Informations personnelles</span>
            </div>

            <div class="profile-grid">

                <div class="profile-field">
                    <span class="profile-label">Email :</span>
                    <span class="profile-value">@profile.Email</span>
                </div>

                <div class="profile-field">
                    <span class="profile-label">Prénom :</span>
                    <span class="profile-value">@profile.FirstName</span>
                </div>

                <div class="profile-field">
                    <span class="profile-label">Nom :</span>
                    <span class="profile-value">@profile.LastName</span>
                </div>

                <div class="profile-field">
                    <span class="profile-label">Téléphone :</span>
                    <span class="profile-value">@profile.PhoneNumber</span>
                </div>

            </div>
        </div>


        <div class="profile-section">

            <div class="profile-section-header">
                <span class="bi bi-building"></span>
                <span>Informations professionnelles</span>
            </div>

            <div class="profile-grid">

                <div class="profile-field">
                    <span class="profile-label">Société :</span>
                    <span class="profile-value">@profile.SocieteName</span>
                </div>

                <div class="profile-field">
                    <span class="profile-label">N° entreprise :</span>
                    <span class="profile-value">@profile.NumeroEntreprise</span>
                </div>

                <div class="profile-field">
                    <span class="profile-label">Rôle :</span>
                    <span class="profile-value">@profile.Role</span>
                </div>

                <div class="profile-field">
                    <span class="profile-label">Statut :</span>
                    <span class="profile-value">@profile.Status</span>
                </div>

            </div>
        </div>


        <button class="btn btn-energy-action"
                type="button"
                @onclick="EnableEdit">
            <span class="bi bi-pencil-fill me-1"></span>
            Modifier mon profil
        </button>
    }
    else if (editModel is not null)
    {
        <div class="profile-section">
        <EditForm Model="editModel" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <h5>Modifier mes informations</h5>

            <div class="mb-3">
                <label class="form-label">Prénom</label>
                <InputText class="form-control"
                           @bind-Value="editModel.FirstName" />
            </div>

            <div class="mb-3">
                <label class="form-label">Nom</label>
                <InputText class="form-control"
                           @bind-Value="editModel.LastName" />
            </div>

            <div class="mb-3">
                <label class="form-label">Téléphone</label>
                <InputText class="form-control"
                           @bind-Value="editModel.PhoneNumber" />
            </div>

            <div class="mb-3">
                <label class="form-label">Société</label>
                <InputText class="form-control"
                           @bind-Value="editModel.SocieteName" />
            </div>

            <div class="mb-3">
                <label class="form-label">Numéro entreprise</label>
                <InputText class="form-control"
                           @bind-Value="editModel.NumeroEntreprise" />
            </div>

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-energy-save"
                        type="submit">
                    <span class="bi bi-check-lg me-1"></span>
                    Enregistrer
                </button>

                <button class="btn btn-energy-cancel"
                        type="button"
                        @onclick="CancelEdit">
                    <span class="bi bi-x-lg me-1"></span>
                    Annuler
                </button>
            </div>
        </EditForm>
        </div>
    }

@if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success mt-3">
            @successMessage
        </div>
    }
}

    @code {
    private bool isLoading = true;
    private bool isEditMode = false; //on consulte la page,puis si on souhaite modifier on cliquer sur Modifier le profil

    private string? errorMessage;
    private string? successMessage;

    private CurrentUserProfileDto? profile;       //lecture
    private UpdateUserProfileFormModel? editModel; //Modification


    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        isLoading = true;
        errorMessage = null;
        //successMessage = null;

        var result = await Sender.Send(new GetMyUserProfile());

        if (!result.IsSuccess)
        {
            errorMessage = "Impossible de charger le profil.";
            isLoading = false;
            return;
        }

        profile = result.Value;
        
        isLoading = false;
    }

    private async Task SaveAsync()
    {
        if (editModel is null)
            return;

        errorMessage = null;
        successMessage = null;

        var result = await Sender.Send(new UpdateMyUserProfile(
            editModel.FirstName,
            editModel.LastName,
            editModel.PhoneNumber,
            editModel.SocieteName,
            editModel.NumeroEntreprise
        ));

        if (!result.IsSuccess)
        {
            errorMessage = "La mise à jour du profil a échoué.";
            return;
        }


        await LoadProfileAsync();
        editModel = null;
        isEditMode = false;
        successMessage = "Profil mis à jour avec succès.";
    }

    private void EnableEdit()
    {
        if (profile is null)
            return;

        editModel = new UpdateUserProfileFormModel
        {
            FirstName = profile.FirstName,
            LastName = profile.LastName,
            PhoneNumber = profile.PhoneNumber,
            SocieteName = profile.SocieteName,
            NumeroEntreprise = profile.NumeroEntreprise
        };

        errorMessage = null;
        successMessage = null;
        isEditMode = true;
    }

    private void CancelEdit()
    {
        editModel = null;
        isEditMode = false;

        errorMessage = null;
        successMessage = null;
    }
  
}