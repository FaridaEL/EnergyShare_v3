@page "/matching/search"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Mediator
@using EnergyShare_v3.Application.Features.Matching
@using EnergyShare_v3.Application.Features.PointAccess

@inject ISender Sender

<PageTitle>Trouver un match</PageTitle>

@* <div class="container py-4"> *@
<div class="page-shell py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title mb-1">Trouver un match énergétique</h2>
            <p class="page-subtitle mb-0">Découvrez les profils compatibles avec votre point d’accès.</p>
        </div>

        <a class="btn btn-energy-cancel"
           href="/matching/my">
            <span class="bi bi-people-fill me-1"></span>
            Mes matchs
        </a>
    </div>
    <div class="row g-4 mb-4">

        <div class="col-lg-3">
            <div class="card responsive-card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body">
                    <div class="text-muted small">Matchs trouvés</div>
                    <div class="display-6 fw-bold">@PotentialMatches.Count</div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card responsive-card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body">

                    <label class="form-label fw-semibold">
                        Point d’accès
                    </label>

                    <select class="form-select mb-3"
                            @bind="SelectedPointAccessId">

                        <option value="">
                            Sélectionner un point d’accès
                        </option>

                        @foreach (var point in MyPointAccesses)
                        {
                            <option value="@point.Id">
                                @point.AdresseLine1 - @point.CodePostal
                            </option>
                        }
                    </select>

                    <button class="btn btn-energy-action"
                            @onclick="SearchMatches"
                            disabled="@IsSearching">

                        <span class="bi bi-search me-1"></span>

                        @(IsSearching ? "Recherche..." : "Rechercher")
                    </button>

                </div>
            </div>
        </div>

    </div>
  

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert @MessageCss">@Message</div>
    }

    @if (IsLoading)
    {
        <p>Chargement...</p>
    }
    else if (HasSearched && PotentialMatches.Count == 0)
    {
        <div class="alert alert-info rounded-4">
            Aucun match trouvé pour ce point d’accès.
        </div>
    }
    else if (PotentialMatches.Count > 0)
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Suggestions de matchs</h5>

                <div class="table-responsive match-search-table">
                    <table class="table align-middle responsive-table">
                        <thead>
                            <tr>
                                <th>@ContactColumnLabel</th>
                                <th>Distance</th>
                                <th>Quantité<br /><span class="table-unit">kWh</span></th>
                                <th>Prix<br /><span class="table-unit">€/kWh</span></th>
                                <th>Statut</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var match in PotentialMatches)
                            {
                                <tr>
                                    <td><strong>@GetPrenomMatch(match)</strong></td>
                                    <td><strong>@FormatDistance(match.DistanceCalculee)</strong></td>
                                    <td>@GetMatchQuantity(match)</td>
                                    <td>@GetMatchPrice(match)</td>
                                    <td>
                                        @if (match.EstDisponible)
                                        {
                                            <span class="badge bg-success">Libre</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Occupé</span>
                                        }
                                    </td>
                                    <td class="text-end actions-cell">
                                        <a class="save-link"
                                           title="Sauver ce match"
                                           role="button"
                                           @onclick="() => SaveMatch(match)">
                                            ☆
                                        </a>

                                        <a class="contact-link"
                                           title="Contacter @GetContactPrenom(match)"
                                           aria-label="Contacter @GetContactPrenom(match)"
                                           href="@($"/messages/send?to={GetContactUserId(match)}&prenom={Uri.EscapeDataString(GetContactPrenom(match))}")">
                                            ✉
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="text-muted small mt-3 mb-0">
                    Pour des raisons de confidentialité, seules les données utiles au matching sont affichées.
                </p>
            </div>
        </div>
    }
</div>

@code {
    private List<PointAccessSummaryDto> MyPointAccesses { get; set; } = [];
    private List<PotentialMatchDto> PotentialMatches { get; set; } = [];

    private Guid? SelectedPointAccessId { get; set; }

    private bool IsLoading { get; set; } = true;
    private bool IsSearching { get; set; }
    private bool HasSearched { get; set; }

    private string? Message { get; set; }
    private string MessageCss { get; set; } = "alert-info";


    private bool CurrentUserIsSeller =>
    PotentialMatches.Any()
    && PotentialMatches.All(m => CurrentUserId == m.VendeurUserId);

    private bool CurrentUserIsBuyer =>
        PotentialMatches.Any()
        && PotentialMatches.All(m => CurrentUserId == m.AcheteurUserId);

    private string ContactColumnLabel =>
        CurrentUserIsSeller ? "Acheteur"
        : CurrentUserIsBuyer ? "Vendeur"
        : "Match";

    private static string FormatDistance(decimal distance)
    {
        if (distance < 0.05m)
            return "< 50 m";

        if (distance < 1m)
            return $"{distance * 1000:N0} m";

        return $"{distance:N1} km";
    }

    private string GetMatchQuantity(PotentialMatchDto match)
    {
        if (CurrentUserIsSeller)
            return FormatKwh(match.DemandeEnergie_kWh);

        if (CurrentUserIsBuyer)
            return FormatKwh(match.OffreEnergie_kWh);

        return "-";
    }

    private string GetMatchPrice(PotentialMatchDto match)
    {
        if (CurrentUserIsSeller)
            return FormatPrice(match.PrixAchatCible_Eur);

        if (CurrentUserIsBuyer)
            return FormatPrice(match.PrixVenteCible_Eur);

        return "-";
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await Sender.Send(new GetMyPointAccesses());

        if (!result.IsSuccess)
        {
            Message = "Impossible de charger vos points d’accès.";
            MessageCss = "alert-danger";
            IsLoading = false;
            return;
        }

        MyPointAccesses = result.Value.ToList();
        SelectedPointAccessId = MyPointAccesses.FirstOrDefault()?.Id;
        IsLoading = false;
    }
    private async Task SearchMatches()
    {
        if (SelectedPointAccessId is null)
        {
            Message = "Veuillez sélectionner un point d’accès.";
            MessageCss = "alert-warning";
            return;
        }

        IsSearching = true;
        HasSearched = true;
        Message = null;

        var result = await Sender.Send(new SearchPotentialMatchesQuery(SelectedPointAccessId.Value));

        if (!result.IsSuccess)
        {
            Message = "La recherche de match a échoué.";
            MessageCss = "alert-danger";
            IsSearching = false;
            return;
        }

        // PotentialMatches = result.Value.ToList();
        PotentialMatches = result.Value
            .OrderBy(m => m.DistanceCalculee)
             .ToList();
        Message = $"{PotentialMatches.Count} match(s) potentiel(s) trouvé(s).";
        MessageCss = "alert-success";
        IsSearching = false;
    }


    private async Task SaveMatch(PotentialMatchDto match)
    {
        var result = await Sender.Send(new CreateMatch(
            match.PointAccessVendeurId,
            match.PointAccessAcheteurId,
            match.DistanceCalculee));

        if (result.IsSuccess)
        {
            Message = "Match sauvegardé dans vos matchs.";
            MessageCss = "alert-success";
        }
        else
        {
            Message = "Impossible de sauvegarder ce match.";
            MessageCss = "alert-danger";
        }
    }

    private static string FormatKwh(decimal? value)
        => value.HasValue ? $"{value.Value:N0}" : "-";

    private static string FormatPrice(decimal? value)
        => value.HasValue ? $"{value.Value:N2}" : "-";

    

    private Guid? CurrentUserId =>
    MyPointAccesses.FirstOrDefault(p => p.Id == SelectedPointAccessId)?.UserId;

    private string GetPrenomMatch(PotentialMatchDto match)
    {
        if (CurrentUserId == match.VendeurUserId)
            return match.PrenomAcheteurMatch;

        if (CurrentUserId == match.AcheteurUserId)
            return match.PrenomVendeurMatch;

        return "Utilisateur";
    }

    private Guid GetContactUserId(PotentialMatchDto match)
    {
        return match.VendeurUserId == CurrentUserId
            ? match.AcheteurUserId
            : match.VendeurUserId;
    }

    private string GetContactPrenom(PotentialMatchDto match)
    {
        return match.VendeurUserId == CurrentUserId
            ? match.PrenomAcheteurMatch
            : match.PrenomVendeurMatch;
    }

}