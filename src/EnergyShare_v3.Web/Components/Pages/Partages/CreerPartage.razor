@page "/partages/create"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Mediator
@using EnergyShare_v3.Application.Features.Partage
@using EnergyShare_v3.Application.Features.PointAccess
@using EnergyShare_v3.Domain.Enums
@using EnergyShare_v3.Web.Models.Partage

@inject ISender Sender
@inject NavigationManager Navigation

<PageTitle>Créer un partage</PageTitle>

<h3>Créer un partage</h3>

<div class="page-shell py-4">
<p class="text-muted">
    Créez un partage d’énergie. Vous serez considéré comme l’interlocuteur unique.
</p>

@if (isLoading)
{
    <p>Chargement...</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-warning">@errorMessage</div>
    }

    @if (injectionPoints.Count == 0)
    {
        <div class="alert alert-info">
            Vous devez d’abord posséder un point d’accès d’injection pour créer un partage.
        </div>

        <a href="/mes-points-access"
           class="btn btn-energy-action">
            <span class="bi bi-plus-circle-fill me-1"></span>
            Créer mon point d’accès
        </a>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Nouveau partage</h5>

                <EditForm Model="model" OnValidSubmit="CreateAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                     <div class="mb-3">
                        <label class="form-label">Point d'accès injecteur</label>

                        <InputSelect class="form-select"
                                     @bind-Value="model.PointAccessId">

                            <option value="">Sélectionnez un point d'accès</option>

                            @foreach (var point in injectionPoints)
                            {
                                @* <option value="@point.Id">
                                    @FormatEan(point.EAN) — @point.AdresseLine1 - @point.CodePostal
                                </option> *@

                                <option value="@point.Id">
                                    @point.EAN — @point.AdresseLine1 - @point.CodePostal
                                </option>
                            }

                        </InputSelect>

                        <small class="text-muted">
                            Seuls vos points d'accès actifs injectant de l'énergie
                            peuvent être utilisés pour créer un partage.
                        </small>
                    </div>
                    

                    <div class="mb-3">
                        <label class="form-label">Nom du partage</label>
                        <InputText class="form-control" @bind-Value="model.Nom" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Type de partage</label>
                        <InputSelect class="form-select" @bind-Value="model.EnergieType">
                            <option value="@PartageEnergieType.PairToPair">Pair à pair</option>
                            <option value="@PartageEnergieType.MemeBatiment">Même bâtiment</option>
                        </InputSelect>
                        <small class="text-muted">
                            La communauté d’énergie est prévue plus tard, hors MVP.
                        </small>
                    </div>

                    <div class="alert alert-info">
                        💡 Après la création, vous pourrez ajouter les membres du partage.
                    </div>

                    @* <button class="btn btn-primary" type="submit" disabled="@isSaving">
                        @(isSaving ? "Création..." : "Créer le partage")
                    </button>

                    <a href="/partages/my" class="btn btn-outline-secondary ms-2">
                        Annuler
                    </a> *@
                    <div class="d-flex gap-2 mt-3">

                        <button class="btn btn-energy-action"
                                type="submit"
                                disabled="@isSaving">
                            <span class="bi bi-plus-circle-fill me-1"></span>
                            @(isSaving ? "Création..." : "Créer le partage")
                        </button>

                        @* <a href="/partages/my"
                           class="btn btn-energy-cancel">
                            <span class="bi bi-x-lg me-1"></span>
                            Annuler
                        </a> *@

                    </div>
                </EditForm>
            </div>
        </div>
    }
}

</div>

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    // private bool hasInjectionPoint = false;
    private List<PointAccessSummaryDto> injectionPoints = []; // un utilisateur peut avoir plusieurs points d'accès d'injection
    private string? errorMessage;

    private PartageFormModel model = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        var pointsResult = await Sender.Send(new GetMyPointAccesses());

        if (!pointsResult.IsSuccess)
        {
            errorMessage = "Impossible de vérifier vos points d’accès.";
            isLoading = false;
            return;
        }

        //hasInjectionPoint = pointsResult.Value.Any(p => p.EstActif && p.IsInjectionPoint);
        injectionPoints = pointsResult.Value.Where(p => p.EstActif && p.IsInjectionPoint).ToList();

        isLoading = false;
    }

    private async Task CreateAsync()
    {
        isSaving = true;
        errorMessage = null;

        // var result = await Sender.Send(new CreatePartage(
        //     model.Nom,
        //     model.EnergieType));
        if (!model.PointAccessId.HasValue)
        {
            errorMessage = "Veuillez sélectionner un point d'accès.";
            isSaving = false;
            return;
        }

        var result = await Sender.Send(new CreatePartage(
            model.Nom,
            model.EnergieType,
            model.PointAccessId.Value));


        if (!result.IsSuccess)
        {
            errorMessage = "Impossible de créer le partage. Vérifiez les informations saisies.";
            isSaving = false;
            return;
        }

        // Navigation.NavigateTo($"/partages/my");
        Navigation.NavigateTo($"/partages/{result.Value}");
    }

    // private static string FormatEan(string? ean)
    // {
    //     if (string.IsNullOrWhiteSpace(ean))
    //         return "EAN non renseigné";

    //     return ean.Length <= 6
    //         ? ean
    //         : $"••••••{ean[^6..]}"; // on affiche les 6 derniers caractères de l'EAN pour des raisons de confidentialité
    // }
}