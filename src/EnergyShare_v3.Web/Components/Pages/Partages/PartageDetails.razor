            </div>
        </div>
    }

    @* =========================================================
   ERREUR DEMANDE PÉRIMÈTRE
   ========================================================= *@

    @if (!string.IsNullOrWhiteSpace(perimetreError))
    {
        <div class="alert alert-warning mt-3">
            @perimetreError
        </div>
    }

