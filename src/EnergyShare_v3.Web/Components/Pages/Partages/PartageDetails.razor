@page "/partages/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IJSRuntime JS //nécessaire pour copier le code d'invitation dans le presse-papier

@using Microsoft.AspNetCore.Authorization
@using Mediator
@using EnergyShare_v3.Application.Features.Partage
@using EnergyShare_v3.Domain.Enums
@using EnergyShare_v3.Web.Models.Partage
@using Microsoft.JSInterop  

@inject ISender Sender
@* =========================================================
   TITRE PAGE affiché dans le navigateur.
   ========================================================= *@

<PageTitle>Dossier de partage</PageTitle>

<h3>Dossier de partage</h3>
@* =========================================================
   ÉTAT DE CHARGEMENT    : Affiché pendant le chargement des données du partage.
   ========================================================= *@

@if (isLoading)
{
    <p>Chargement...</p>
}
@* =========================================================
   AFFICHAGE ERREUR  si chargement du partage échoue.
   ========================================================= *@

else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning">@errorMessage</div>
}
@* =========================================================
   AFFICHAGE DU PARTAGE SI il existe.
   ========================================================= *@


else if (partage is not null)
{
    @* =========================================================
       CARD : PROGRESSION DU DOSSIER  admin du partage.  lié au statut du dossier ( cf. backend)
       ========================================================= *@
   
    
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">

                @* =========================================================
                   PARTIE GAUCHE : BARRE DE PROGRESSION + ÉTAPES  --> TODO : éventuellemnt corriger les étapes 
                   ou les retirer pour gain de place ..
                   ========================================================= *@ 
  
                
                <div class="flex-grow-1">
                    <h5 class="mb-2">Progression du dossier</h5>

                    <div class="progress mb-2">
                        <div class="progress-bar" style="width:@($"{partage.Progression}%")">
                            @partage.Progression%
                        </div>
                    </div>
                    @* =========================================================
                       CHECKLIST DES ÉTAPES DU DOSSIER   : ! à revoir TODO  : 
                       -1) Création du partage 
                       - 2) participants :  Vert si minimum atteint.
                        - 3) perimetre  : TODO : progression périmètre 
                        - 4) validation GRD : Vert si le partage est En attente validation ou Actif

                       ========================================================= *@

                    <ul class="mb-0">

                        <li class="text-success">✔ Création du partage</li>
                        <li class="@(partage.NombreParticipants >= 2 ? "text-success" : "text-muted")">
                            @(partage.NombreParticipants >= 2 ? "✔" : "○") Participants
                        </li>
                        <li class="@(PerimetreConnu ? "text-success" : "text-muted")">
                            @(PerimetreConnu ? "✔" : "○") Périmètre électrique
                        </li>
                            
                        <li class="@(partage.Statut == PartageEnergieStatutType.EnAttenteValidation || partage.Statut == PartageEnergieStatutType.Actif ? "text-success" : "text-muted")">
                            @(partage.Statut == PartageEnergieStatutType.EnAttenteValidation || partage.Statut == PartageEnergieStatutType.Actif ? "✔" : "○") Validation GRD
                        </li>
                    </ul>
                </div>

                @* =========================================================
                   PARTIE DROITE : STATUT DU PARTAGE
                   ========================================================= *@

                <div class="status-box text-center">
                    <div class="text-muted small">Statut du partage</div>
                    <div class="fw-bold text-danger fs-5">
                        @GetStatutLabel(partage.Statut)
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* =========================================================
       MESSAGE LECTURE SEULE   : Affiché si l'utilisateur ne peut pas modifier.
       TODO : vérifier si bonne implémentation
       ========================================================= *@

    @if (!partage.CanEdit)
    {
        <div class="alert alert-info">
            Vous consultez ce dossier en lecture seule.
        </div>
    }
    @* =========================================================
