@page "/partages/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IJSRuntime JS //nécessaire pour copier le code d'invitation dans le presse-papier

@using Microsoft.AspNetCore.Authorization
@using Mediator
@using EnergyShare_v3.Application.Features.Partage
@using EnergyShare_v3.Domain.Enums
@using EnergyShare_v3.Web.Models.Partage


@inject ISender Sender
@* =========================================================
   TITRE PAGE affiché dans le navigateur.
   ========================================================= *@

<PageTitle>Dossier de partage</PageTitle>

<h3>Dossier de partage</h3>
@* =========================================================
   ÉTAT DE CHARGEMENT    : Affiché pendant le chargement des données du partage.
   ========================================================= *@

@if (isLoading)
{
    <p>Chargement...</p>
}
@* =========================================================
   AFFICHAGE ERREUR  si chargement du partage échoue.
   ========================================================= *@

else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning">@errorMessage</div>
}
@* =========================================================
   AFFICHAGE DU PARTAGE SI il existe.
   ========================================================= *@

else if (partage is not null)
{
    @* =========================================================
   STATUT DU PARTAGE
   La barre de progression a été retirée provisoirement.
   Le statut métier reste affiché car il constitue une information importante du dossier.
   ========================================================= *@

    <div class="d-flex justify-content-end mb-3">
        <div class="status-box text-center">
            <div class="text-muted small">
                Statut du partage
            </div>

            <div class="fw-bold fs-5">
                @GetStatutLabel(partage.Statut)
            </div>
        </div>
    </div>

    @* =========================================================
       MESSAGE LECTURE SEULE   : Affiché si l'utilisateur ne peut pas modifier.
       TODO : vérifier si bonne implémentation
       ========================================================= *@

    @if (!partage.CanEdit)
    {
        <div class="alert alert-info">
            Vous consultez ce dossier en lecture seule.
        </div>
    }
 
    @* =========================================================
   CARD : DONNÉES DU PARTAGE

   Fonctionnement :
   - par défaut, les informations sont affichées en consultation ;
   - si l'utilisateur possède les droits de modification,
     un bouton "Modifier le partage" est proposé ;
   - les champs éditables ne sont affichés qu'après ce clic.
   ========================================================= *@

    <div class="card mb-3">

        <div class="card-header fw-bold">
            Données du partage
        </div>

        <div class="card-body">

            @* =====================================================
           MÉTADONNÉES DU DOSSIER
           Données informatives, toujours en lecture seule.
           ===================================================== *@

            <div class="metadata-box mb-3">

                <div>
                    <span class="metadata-label">Créé le :</span>
                    <span>@partage.CreatedAt.ToShortDateString()</span>
                </div>

                <div>
                    <span class="metadata-label">Dernière modification le :</span>
                    <span>@FormatDate(partage.UpdatedAt)</span>
                </div>

                <div>
                    <span class="metadata-label">Participants :</span>
                    <span>@partage.NombreParticipants</span>
                </div>

            </div>


            @* =====================================================
           MODE CONSULTATION    :   Les données sont affichées mais ne sont pas éditables.
           ===================================================== *@

            @if (!isEditMode)
            {
                <div class="partage-detail-grid">

                    <div class="partage-detail-field">
                        <span class="partage-detail-label">
                            Nom du partage :
                        </span>

                        <span>
                            @partage.Nom
                        </span>
                    </div>


                    <div class="partage-detail-field">
                        <span class="partage-detail-label">
                            Type de partage :
                        </span>

                        <span>
                            @(partage.EnergieType == PartageEnergieType.PairToPair
                                ? "Pair à pair"
                                : "Même bâtiment")
                        </span>
                    </div>


                    <div class="partage-detail-field">
                        <span class="partage-detail-label">
                            Date de début :
                        </span>

                        <span>
                            @(partage.DateDebut.HasValue
                                ? partage.DateDebut.Value.ToString("dd/MM/yyyy")
                                : "Non définie")
                        </span>
                    </div>


                    <div class="partage-detail-field">
                        <span class="partage-detail-label">
                            Date de fin :
                        </span>

                        <span>
                            @(partage.DateFin.HasValue
                                ? partage.DateFin.Value.ToString("dd/MM/yyyy")
                                : "Non définie")
                        </span>
                    </div>


                    <div class="partage-detail-field partage-detail-description">
                        <span class="partage-detail-label">
                            Description :
                        </span>

                        <span>
                            @(string.IsNullOrWhiteSpace(partage.Description)
                                ? "Aucune description"
                                : partage.Description)
                        </span>
                    </div>

                </div>

                @* =================================================
               ACTION : MODIFIER LE PARTAGE

               Visible uniquement si le backend indique
               que l'utilisateur possède les droits d'édition.
               ================================================= *@

                @if (partage.CanEdit)
                {
                    <div class="mt-4">

                        <button class="btn btn-energy-action"
                                type="button"
                                @onclick="EnableEdit">

                            <span class="bi bi-pencil-fill me-1"></span>
                            Modifier le partage

                        </button>

                    </div>
                }

                @* =========================================================
                   DECLARATION DES MODIFICATIONS AU GRD

                   Ce message apparaît immédiatement après la sauvegarde
                   d'une modification significative sur un partage actif.

                   L'action GRD reste centralisée dans la page PartageDemandes.
                   ========================================================= *@

                @if (hasPendingGrdChanges)
                {
                    <div class="alert alert-warning mt-3 mb-0">

                        <div class="fw-bold mb-1">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Des modifications doivent être déclarées au GRD.
                        </div>

                        <p class="mb-3">
                            Le partage a été modifié.
                            Vous devez transmettre la situation mise à jour au GRD.
                        </p>

                        <a href="@($"/partages/{partage.Id}/demandes")"
                           class="btn btn-energy-action">

                            <i class="bi bi-send me-1"></i>
                            Déclarer les modifications au GRD
                        </a>

                    </div>
                }

            }

            @* =====================================================
           MODE ÉDITION
           Les champs deviennent éditables uniquement
           après avoir cliqué sur "Modifier le partage".
           ===================================================== *@

            else
            {
                <p class="text-muted mb-3">
                    Modifiez les informations nécessaires puis enregistrez vos changements.
                </p>


                @* =========================================================
                   INFORMATION GRD

                   Pour un partage déjà actif, certaines modifications sont considérées comme significatives 
                   et devront être déclarées au GRD.

                   Pour le moment, dans cette page, on retient 4 éléments  : 
                   - le nom ;
                   - le type de partage ;
                   - la date de début ;
                   - la date de fin.

                   La description reste considérée comme une donnée descriptive.
                   Cette liste pourra facilement évoluer par la suite.
                   TODO MÉTIER : Déterminer ultérieurement quels champs peuvent encore
                     être modifiés selon le statut du partage.
                   ========================================================= *@

                @if (partage.Statut == PartageEnergieStatutType.Actif)
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-1"></i>

                        <strong>Attention :</strong>
                        certaines modifications d’un partage actif doivent être déclarées au GRD.

                        <div class="mt-1">
                            Cela concerne actuellement le nom, le type de partage et les dates de début ou de fin.
                        </div>
                    </div>
                }

                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Nom du partage
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="formModel.Nom" />

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Type de partage
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="formModel.EnergieType">

                            <option value="@PartageEnergieType.PairToPair">
                                Pair à pair
                            </option>

                            <option value="@PartageEnergieType.MemeBatiment">
                                Même bâtiment
                            </option>

                        </InputSelect>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Date de début
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="formModel.DateDebut" />

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Date de fin
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="formModel.DateFin" />

                    </div>


                    <div class="col-12">

                        <label class="form-label">
                            Description
                        </label>

                        <InputTextArea class="form-control"
                                       @bind-Value="formModel.Description"
                                       rows="3" />

                    </div>

                </div>


                @* =================================================
               ACTIONS DU MODE ÉDITION   :  Bleu = sauvegarder les données.  Gris = abandonner les modifications.
               ================================================= *@

                <div class="d-flex gap-2 mt-4">

                    <button class="btn btn-energy-save"
                            type="button"
                            @onclick="HandleUpdate">

                        <span class="bi bi-check-lg me-1"></span>
                        Enregistrer

                    </button>


                    <button class="btn btn-energy-cancel"
                            type="button"
                            @onclick="CancelEdit">

                        <span class="bi bi-x-lg me-1"></span>
                        Annuler

                    </button>

                </div>
            }

        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    // variaible pour pour gérer l'édition du partage : modifier, enregistrer les modifications
    //  --> même principe que pour profil
    private bool isEditMode = false;
    private PartageDetailsDto? partage;// données lues depuis la base  
    
    // Indique qu'une modification significative vient d'être enregistrée sur un partage actif.
    // Pour le moment cet indicateur appartient uniquement à l'UI.
    // Il deviendra persistant lorsque l'historique des modifications sera mis en place.
    //Donc LIMITES ! les changements significatifs ne sont visibles que le temps de la connexion.
    private bool hasPendingGrdChanges;
    
    // Variables pour la dde  de validation GRD
    // private DemandeValidationPartageDto? demandeValidation;
    // private string? validationError;
    // private bool isValidationLoading;

    // Modèle UI éditable utilisé par les champs du formulaire.
    // On ne modifie pas directement PartageDetailsDto car c'est un record immutable.
    private PartageDetailsFormModel formModel = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await Sender.Send(new GetPartageById(Id)); //appel backend CQRS/mediator

        if (!result.IsSuccess)
        {
            errorMessage = "Impossible de charger le partage.";
            isLoading = false;
            return;
        }

        partage = result.Value;
        PopulateFormModel();   // Copie les données du DTO vers le modèle éditable
        isEditMode = false;       // Par défaut, la page est en mode consultation
        isLoading = false;
    }

    //on corrigel'affichage de la date doit être au format de Bxl heure locale

    private static string FormatDate(DateTime? date)
    => date?.ToLocalTime().ToString("dd/MM/yyyy") ?? "Non définie";

    private static string FormatDateTime(DateTime? date)
        => date?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Non définie";

    private static string GetBadgeClass(PartageEnergieStatutType statut)
    {
        return statut switch
        {
            PartageEnergieStatutType.Inactif => "bg-secondary",
            PartageEnergieStatutType.EnAttenteValidation => "bg-warning text-dark",
            PartageEnergieStatutType.Actif => "bg-success",
            PartageEnergieStatutType.EnAttenteModification => "bg-warning text-dark",
            PartageEnergieStatutType.Suspendu => "bg-danger",
            PartageEnergieStatutType.EnCoursCloture => "bg-warning text-dark",
            PartageEnergieStatutType.Cloture => "bg-dark",
            _ => "bg-light text-dark"
        };
    }

    private static string GetStatutLabel(PartageEnergieStatutType statut)
    {
        return statut switch
        {
            PartageEnergieStatutType.Inactif => "Brouillon / Inactif",
            PartageEnergieStatutType.EnAttenteValidation => "En attente GRD",
            PartageEnergieStatutType.Actif => "Actif",
            PartageEnergieStatutType.EnAttenteModification => "Modification en attente",
            PartageEnergieStatutType.Suspendu => "Suspendu",
            PartageEnergieStatutType.EnCoursCloture => "Clôture en cours",
            PartageEnergieStatutType.Cloture => "Clôturé",
            _ => statut.ToString()
        };
    }

    private async Task HandleUpdate()
    {
        if (partage is null)
            return;

        // On détermine AVANT la sauvegarde si les changements effectués doivent être déclarés au GRD.
        // Cette règle ne concerne ici que les partages déjà actifs.
        var requiresGrdDeclaration =
            partage.Statut == PartageEnergieStatutType.Actif
            && HasSignificantGeneralChanges(partage, formModel);
       
        var command = new UpdatePartage(
            partage.Id,
            formModel.Nom,
            formModel.Description,
            formModel.EnergieType,
            formModel.DateDebut,
            formModel.DateFin
        );

        var result = await Sender.Send(command);

        if (!result.IsSuccess)
        {
            errorMessage = result.Errors.Any()
                ? string.Join(" | ", result.Errors)
                : $"Erreur lors de la mise à jour. Statut : {result.Status}";

           
                return;
        }
        // Si une donnée significative d'un partage actif a été modifiée,
        // l'interface proposera immédiatement de déclarer les changements au GRD.
        hasPendingGrdChanges = requiresGrdDeclaration;

        // Recharge les données après update (bonne pratique)
        var refresh = await Sender.Send(new GetPartageById(Id));
        if (refresh.IsSuccess)
        {
            partage = refresh.Value;
            PopulateFormModel();
            // Re-synchroniser le formModel 
        }
        isEditMode = false; // Retour au mode consultation après sauvegarde
    }

    /// <summary> Passe la zone "Données du partage" en mode édition.
    /// Le formulaire contient déjà les données chargées depuis le backend. /// </summary>
    private void EnableEdit()
    {
        if (partage is null || !partage.CanEdit)
            return;

        PopulateFormModel();// Toujours repartir des données réellement enregistrées
        errorMessage = null;
        isEditMode = true;
    }

    /// <summary> Annule les modifications en cours. Les valeurs du formulaire sont rechargées depuis les données 
    /// // actuellement enregistrées afin d'éviter de conserver des modifications non sauvegardées.   </summary>
    private void CancelEdit()
    {
        if (partage is null)
            return;

        PopulateFormModel();
        errorMessage = null;
        isEditMode = false;
    }
    /// <summary> Recopie dans le modèle de formulaire les données actuellement enregistrées du partage.
    /// Cette méthode est utilisée après le chargement du partage et lors d'une annulation de modification.  </summary>
    private void PopulateFormModel()
    {
        if (partage is null)
            return;
        formModel = new PartageDetailsFormModel
        {
            Nom = partage.Nom,
            EnergieType = partage.EnergieType,
            DateDebut = partage.DateDebut,
            DateFin = partage.DateFin,
            Description = partage.Description
        };
    }
    /// <summary>
    /// Vérifie si les données générales modifiées doivent faire l'objet d'une déclaration au GRD.
    /// Cette méthode centralise volontairement la liste des champs significatifs pour pouvoir l'adapter facilement.
    /// Les modifications de membres seront traitées séparément dans la fonctionnalité PartageMembres.
    /// </summary>
    private static bool HasSignificantGeneralChanges( PartageDetailsDto current, PartageDetailsFormModel edited)
    {
        return
            // Nom du partage
            !string.Equals(current.Nom?.Trim(), edited.Nom?.Trim(),StringComparison.Ordinal)

            //Description n'est pas considérée comme un changement significatif pour le GRD.
            // || !string.Equals(current.Description?.Trim(), edited.Description?.Trim(),StringComparison.Ordinal)
           
            // Type de partage
            || current.EnergieType != edited.EnergieType
            
            // Dates du partage
            || current.DateDebut?.Date != edited.DateDebut?.Date
            || current.DateFin?.Date != edited.DateFin?.Date;
    }

 }