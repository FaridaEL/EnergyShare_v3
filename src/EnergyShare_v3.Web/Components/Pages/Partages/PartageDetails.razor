@page "/partages/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IJSRuntime JS //nécessaire pour copier le code d'invitation dans le presse-papier

@using Microsoft.AspNetCore.Authorization
@using Mediator
@using EnergyShare_v3.Application.Features.Partage
@using EnergyShare_v3.Domain.Enums
@using EnergyShare_v3.Web.Models.Partage
@using Microsoft.JSInterop  

@inject ISender Sender
@* =========================================================
   TITRE PAGE affiché dans le navigateur.
   ========================================================= *@

<PageTitle>Dossier de partage</PageTitle>

<h3>Dossier de partage</h3>
@* =========================================================
   ÉTAT DE CHARGEMENT    : Affiché pendant le chargement des données du partage.
   ========================================================= *@

@if (isLoading)
{
    <p>Chargement...</p>
}
@* =========================================================
   AFFICHAGE ERREUR  si chargement du partage échoue.
   ========================================================= *@

else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning">@errorMessage</div>
}
@* =========================================================
   AFFICHAGE DU PARTAGE SI il existe.
   ========================================================= *@


else if (partage is not null)
{
    @* =========================================================
       CARD : PROGRESSION DU DOSSIER  admin du partage.  lié au statut du dossier ( cf. backend)
       ========================================================= *@
   
    
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">

                @* =========================================================
                   PARTIE GAUCHE : BARRE DE PROGRESSION + ÉTAPES  --> TODO : éventuellemnt corriger les étapes 
                   ou les retirer pour gain de place ..
                   ========================================================= *@ 
  
                
                <div class="flex-grow-1">
                    <h5 class="mb-2">Progression du dossier</h5>

                    <div class="progress mb-2">
                        <div class="progress-bar" style="width:@($"{partage.Progression}%")">
                            @partage.Progression%
                        </div>
                    </div>
                    @* =========================================================
                       CHECKLIST DES ÉTAPES DU DOSSIER   : ! à revoir TODO  : 
                       -1) Création du partage 
                       - 2) participants :  Vert si minimum atteint.
                        - 3) perimetre  : TODO : progression périmètre 
                        - 4) validation GRD : Vert si le partage est En attente validation ou Actif

                       ========================================================= *@

                    <ul class="mb-0">

                        <li class="text-success">✔ Création du partage</li>
                        <li class="@(partage.NombreParticipants >= 2 ? "text-success" : "text-muted")">
                            @(partage.NombreParticipants >= 2 ? "✔" : "○") Participants
                        </li>
                        <li class="@(PerimetreConnu ? "text-success" : "text-muted")">
                            @(PerimetreConnu ? "✔" : "○") Périmètre électrique
                        </li>
                            
                        <li class="@(partage.Statut == PartageEnergieStatutType.EnAttenteValidation || partage.Statut == PartageEnergieStatutType.Actif ? "text-success" : "text-muted")">
                            @(partage.Statut == PartageEnergieStatutType.EnAttenteValidation || partage.Statut == PartageEnergieStatutType.Actif ? "✔" : "○") Validation GRD
                        </li>
                    </ul>
                </div>

                @* =========================================================
                   PARTIE DROITE : STATUT DU PARTAGE
                   ========================================================= *@

                <div class="status-box text-center">
                    <div class="text-muted small">Statut du partage</div>
                    <div class="fw-bold text-danger fs-5">
                        @GetStatutLabel(partage.Statut)
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* =========================================================
       MESSAGE LECTURE SEULE   : Affiché si l'utilisateur ne peut pas modifier.
       TODO : vérifier si bonne implémentation
       ========================================================= *@

    @if (!partage.CanEdit)
    {
        <div class="alert alert-info">
            Vous consultez ce dossier en lecture seule.
        </div>
    }
    @* =========================================================
       CARD : DONNÉES DU PARTAGE    : métadonnées + informations éditables du partage.
       ========================================================= *@

    <div class="card mb-3">
        <div class="card-header fw-bold">
            Données du partage
        </div>

        <div class="card-body">
            @* =========================================================
               MÉTADONNÉES DU DOSSIER    : non éditable mais mise à jour auto 
               ========================================================= *@
            <div class="metadata-box mb-3">
                <div>
                    <span class="metadata-label">Créé le :</span>
                    <span>@partage.CreatedAt.ToShortDateString()</span>
                </div>

                <div>
                    <span class="metadata-label">Dernière modification le :</span>
                    <span>@FormatDate(partage.UpdatedAt)</span>
                </div>

                <div>
                    <span class="metadata-label">Participants :</span>
                    <span>@partage.NombreParticipants</span>
                </div>
            </div>

            <p class="text-muted mb-3">
                Cette zone vous permet de compléter les informations de votre partage avant de demander une validation au GRD (Sibelga).
            </p>

            @* =========================================================
               MÉTADONNÉES DU DOSSIER    : éditable 
               TODO : en cas de modification il faut idéalement dder une validation 
               TODO : déterminer quel élements sont éditables ou pas 
               ========================================================= *@
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nom du partage</label>
                    <InputText class="form-control"
                               @bind-Value="formModel.Nom"
                               disabled="@(!partage.CanEdit)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Type de partage</label>
                    <InputSelect class="form-select"
                                 @bind-Value="formModel.EnergieType"
                                 disabled="@(!partage.CanEdit)">
                        <option value="@PartageEnergieType.PairToPair">Pair à pair</option>
                        <option value="@PartageEnergieType.MemeBatiment">Même bâtiment</option>
                    </InputSelect>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Date de début</label>
                    <InputDate class="form-control"
                               @bind-Value="formModel.DateDebut"
                               disabled="@(!partage.CanEdit)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Date de fin</label>
                    <InputDate class="form-control"
                               @bind-Value="formModel.DateFin"
                               disabled="@(!partage.CanEdit)" />
                </div>

                <div class="col-12">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control"
                                   @bind-Value="formModel.Description"
                                   rows="3"
                                   disabled="@(!partage.CanEdit)" />
                </div>
            </div>
        </div>
    </div>

    @* =========================================================
   ACTIONS PRINCIPALES DU DOSSIER DE PARTAGE
   ========================================================= *@


    <div class="d-flex gap-2 mt-3 flex-wrap">

        @* =========================================================
       ENREGISTRER LES MODIFICATIONS DU PARTAGE
       ========================================================= *@
        <button class="btn btn-primary" @onclick="HandleUpdate" disabled="@(!partage.CanEdit)">
            Enregistrer les modifications
        </button>
        @* =========================================================
       INVITER UN PARTICIPANT
       - Génère un code d’invitation sécurisé.
       - Désactivé si :
         -> l'utilisateur ne peut pas modifier le partage ;
         -> une génération est déjà en cours.
       ========================================================= *@

        <button class="btn btn-outline-primary"
                @onclick="HandleInvitation"
                disabled="@(!partage.CanEdit || isInvitationLoading)">
            @(isInvitationLoading ? "Préparation..." : "Inviter un participant")
        </button>

        @* <button class="btn btn-outline-secondary" disabled="@(!partage.CanEdit || partage.NombreParticipants < 2)">
            Demander info périmètre
        </button> *@

        @* =========================================================
       DEMANDE D’INFORMATION DE PÉRIMÈTRE
       - Permet d’envoyer une demande au GRD.
       - Désactivé si :
         -> l'utilisateur ne peut pas modifier ;
         -> moins de 2 participants ;
         -> une dde est déjà en cours ;
         -> une dde existe déjà en attente.
       ========================================================= *@


        <button class="btn btn-outline-secondary"
                @onclick="HandleDemandePerimetre"
                disabled="@(!partage.CanEdit 
                            || partage.NombreParticipants < 2 
                            || isPerimetreLoading
                            || HasDemandePerimetreEnAttente )">
            @(isPerimetreLoading ? "Envoi..." : "Demander info périmètre")
        </button>


        @* <button class="btn btn-success" disabled="@(!partage.CanEdit || partage.NombreParticipants < 2)">
            Demander validation GRD
        </button> *@
        @* bouton désactivé SI  :
            - l'user ne peut pas modifier le partage ;
            - le nombre minimum de participants n'est pas atteint ;
            - une validation GRD est déjà en cours.  *@
       
        @* =========================================================
       DEMANDE DE VALIDATION GRD
       - Envoie officiellement le partage au GRD.
       - Désactivé si :
         -> l'utilisateur ne peut pas modifier ;
         -> moins de 2 participants ;
         -> une validation est déjà en cours ;
         -> le partage est déjà en attente de validation.
       ========================================================= *@      
            
            
            <button class="btn btn-success"
                @onclick="HandleDemandeValidation"
                disabled="@(!partage.CanEdit
                                    || partage.NombreParticipants < 2
                                    || isValidationLoading
                                    || partage.Statut == PartageEnergieStatutType.EnAttenteValidation)">
            @GetValidationButtonLabel()
        </button>


    </div>

    @* =========================================================
   BLOC CODE D’INVITATION
   - Affiché après génération d’un code.
   ========================================================= *@

    @if (invitation is not null)
    {
        <div class="card mt-3 mb-3 border-primary">
            <div class="card-body">
                <h5 class="card-title">Code d’invitation</h5>

                <p class="text-muted">
                    Transmettez ce code à la personne que vous souhaitez inviter.
                    Elle devra se connecter à EnergyShare, puis cliquer sur
                    <strong>Rejoindre un partage</strong>.
                    Ce code expire dans 24 heures.
                </p>

                <div class="input-group mb-2">
                    <input class="form-control fw-bold"
                           value="@invitation.InvitationCode"
                           readonly />

                    <button class="btn btn-outline-secondary"
                            @onclick="CopyInvitationCode">
                        Copier
                    </button>
                </div>

                <div class="small text-muted">
                    Expire le : @invitation.InvitationCodeExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </div>

                @if (!string.IsNullOrWhiteSpace(invitationMessage))
                {
                    <div class="alert alert-success mt-3 mb-0">
                        @invitationMessage
                    </div>
                }
            </div>
        </div>
    }

    @* =========================================================
   ERREUR INVITATION
   ========================================================= *@

    @if (!string.IsNullOrWhiteSpace(invitationError))
    {
        <div class="alert alert-warning mt-3">
            @invitationError
        </div>
    }

    @* =========================================================
   BLOC DEMANDE D’INFORMATION DE PÉRIMÈTRE
   - Affiché après envoi de la demande.
   - Contient :
     -> statut ;
     -> périmètre confirmé ;
     -> commentaire GRD ;
     -> détails envoyés.
   ========================================================= *@
    @if (demandePerimetre is not null)
    {
        <div class="card mt-3 mb-3 border-secondary">
            <div class="card-body">
                <h5 class="card-title">Demande d’information de périmètre</h5>

                <p class="text-muted">
                    Votre demande a été préparée et envoyée au GRD.
                    Les adresses des participants actifs ont été ajoutées automatiquement à la demande.
                </p>

                <div class="metadata-box mb-3">
                    <div>
                        <span class="metadata-label">Statut :</span>
                        <span>@demandePerimetre.ResponseStatus</span>

                        @* =========================================================
                       PÉRIMÈTRE CONFIRMÉ PAR LE GRD
                       ========================================================= *@


                        @if (demandePerimetre.PerimetreConfirme is not null)
                        {
                            <div class="mt-2">
                                <strong>Périmètre confirmé :</strong>
                                <span class="badge bg-success ms-2">
                                    @demandePerimetre.PerimetreConfirme
                                </span>
                            </div>
                        }


                        @* =========================================================
                       COMMENTAIRE DU GRD
                       ========================================================= *@
                        @if (!string.IsNullOrWhiteSpace(demandePerimetre.CommentaireReponseGRD))
                        {
                            <div class="mt-2">
                                <strong>Commentaire du GRD :</strong>
                                <span class="badge bg-success ms-2">
                                    @demandePerimetre.CommentaireReponseGRD
                                </span>
                            </div>
                        }


                    </div>

                    <div>
                        <span class="metadata-label">Date de demande :</span>
                        <span>@FormatDateTime(demandePerimetre.DateDemande)</span>
                    </div>
                </div>

                @* =========================================================
               DÉTAILS TRANSMIS AU GRD
               ========================================================= *@

                <label class="form-label">Détails transmis au GRD</label>
                <textarea class="form-control"
                          rows="5"
                          readonly>@demandePerimetre.DetailsDemande</textarea>
            </div>
        </div>
    }

    @* =========================================================
   ERREUR DEMANDE PÉRIMÈTRE
   ========================================================= *@

    @if (!string.IsNullOrWhiteSpace(perimetreError))
    {
        <div class="alert alert-warning mt-3">
            @perimetreError
        </div>
    }

}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private PartageDetailsDto? partage;
    
    //var pour inviter et rejoindre un partage
    private InvitationCodeDto? invitation;
    private string? invitationMessage;
    private string? invitationError;
    private bool isInvitationLoading;

    //var pour demande périmètre
    private DemandePerimetreDto? demandePerimetre;
    private string? perimetreError;
    private bool isPerimetreLoading;
    private bool HasDemandePerimetreEnAttente =>
    demandePerimetre?.ResponseStatus == "EnAttente"; //permet de désativer le bouton si une dde est en attente 

    private bool PerimetreConnu =>
    partage?.EnergieType == PartageEnergieType.MemeBatiment
    || demandePerimetre?.PerimetreConfirme is not null;

    // Variables pour la dde  de validation GRD
    private DemandeValidationPartageDto? demandeValidation;
    private string? validationError;
    private bool isValidationLoading;

    // Modèle UI éditable utilisé par les champs du formulaire.
    // On ne modifie pas directement PartageDetailsDto car c'est un record immutable.
    private PartageDetailsFormModel formModel = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await Sender.Send(new GetPartageById(Id)); //appel backend CQRS/mediator

        if (!result.IsSuccess)
        {
            errorMessage = "Impossible de charger le partage.";
            isLoading = false;
            return;
        }

        partage = result.Value;
        demandePerimetre = partage.DerniereDemandePerimetre;
        // Copie du DTO vers le modèle éditable du formulaire.
        formModel = new PartageDetailsFormModel
        {
            Nom = partage.Nom,
            Description = partage.Description,
            EnergieType = partage.EnergieType,
            DateDebut = partage.DateDebut,
            DateFin = partage.DateFin
        };
        isLoading = false;
    }

    // private static string FormatDate(DateTime? date)
    //     => date?.ToShortDateString() ?? "Non définie";

    //on corrigel'affichage de la date doit être au format de Bxl heure locale

    private static string FormatDate(DateTime? date)
    => date?.ToLocalTime().ToString("dd/MM/yyyy") ?? "Non définie";

    private static string FormatDateTime(DateTime? date)
        => date?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Non définie";

    private static string GetBadgeClass(PartageEnergieStatutType statut)
    {
        return statut switch
        {
            PartageEnergieStatutType.Inactif => "bg-secondary",
            PartageEnergieStatutType.EnAttenteValidation => "bg-warning text-dark",
            PartageEnergieStatutType.Actif => "bg-success",
            PartageEnergieStatutType.EnAttenteModification => "bg-warning text-dark",
            PartageEnergieStatutType.Suspendu => "bg-danger",
            PartageEnergieStatutType.EnCoursCloture => "bg-warning text-dark",
            PartageEnergieStatutType.Cloture => "bg-dark",
            _ => "bg-light text-dark"
        };
    }

    private static string GetStatutLabel(PartageEnergieStatutType statut)
    {
        return statut switch
        {
            PartageEnergieStatutType.Inactif => "Brouillon / Inactif",
            PartageEnergieStatutType.EnAttenteValidation => "En attente GRD",
            PartageEnergieStatutType.Actif => "Actif",
            PartageEnergieStatutType.EnAttenteModification => "Modification en attente",
            PartageEnergieStatutType.Suspendu => "Suspendu",
            PartageEnergieStatutType.EnCoursCloture => "Clôture en cours",
            PartageEnergieStatutType.Cloture => "Clôturé",
            _ => statut.ToString()
        };
    }

    private async Task HandleUpdate()
    {
        if (partage is null)
            return;

        var command = new UpdatePartage(
            partage.Id,
            formModel.Nom,
            formModel.Description,
            formModel.EnergieType,
            formModel.DateDebut,
            formModel.DateFin
            
        );

        var result = await Sender.Send(command);

        if (!result.IsSuccess)
        {
            errorMessage = "Erreur lors de la mise à jour.";
            return;
        }

        // Recharge les données après update (bonne pratique)
        var refresh = await Sender.Send(new GetPartageById(Id));
        if (refresh.IsSuccess)
        {
            partage = refresh.Value;

            // Re-synchroniser le formModel
            formModel = new PartageDetailsFormModel
            {
                Nom = partage.Nom,
                Description = partage.Description,
                EnergieType = partage.EnergieType,
                DateDebut = partage.DateDebut,
                DateFin = partage.DateFin
            };
        }
    }

    private async Task HandleInvitation()
    {
        if (partage is null)
            return;

        invitationError = null;
        invitationMessage = null;
        isInvitationLoading = true;

        var result = await Sender.Send(new GetInvitationCodePartage(partage.Id));

        isInvitationLoading = false;

        if (!result.IsSuccess)
        {
            invitationError = "Impossible de générer le code d’invitation.";
            return;
        }

        invitation = result.Value;
    }

    private async Task CopyInvitationCode()
    {
        if (invitation is null)
            return;

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", invitation.InvitationCode);

        invitationMessage = "Code copié dans le presse-papiers.";
    }

    //gestion des demandes de périmètre
    private async Task HandleDemandePerimetre()
    {
        if (partage is null)
            return;

        perimetreError = null;
        isPerimetreLoading = true;

        var result = await Sender.Send(new DemandeInfoPerimetrePartage(partage.Id));

        isPerimetreLoading = false;

        if (!result.IsSuccess)
        {
            perimetreError = "Impossible d’envoyer la demande d’information de périmètre.";
            return;
        }

        // On conserve le DTO retourné pour afficher la box de confirmation.
        demandePerimetre = result.Value;
    }

    // Gestion de la demande de validation du partage auprès du GRD
    private async Task HandleDemandeValidation()
    {
        if (partage is null)
            return;

        validationError = null;
        isValidationLoading = true;

        var result = await Sender.Send(new DemandeValidationPartage(partage.Id));

        isValidationLoading = false;

        if (!result.IsSuccess)
        {
            validationError = "Impossible d’envoyer la demande de validation GRD.";
            return;
        }

    // On conserve le DTO retourné si on veut afficher une confirmation.
    demandeValidation = result.Value;

    // On recharge le partage pour afficher le nouveau statut :
    // Inactif -> EnAttenteValidation
    var refresh = await Sender.Send(new GetPartageById(Id));

    if (refresh.IsSuccess)
    {
        partage = refresh.Value;
        demandePerimetre = partage.DerniereDemandePerimetre;
    }
} 
    
    //désactivation du bouton dder valider : permet d'afficher un label explicatif à l'user.
    private string GetValidationButtonLabel()
    {
        if (partage?.Statut == PartageEnergieStatutType.EnAttenteValidation)
            return "Validation GRD en cours...";

        return "Demander validation GRD";
    }

}