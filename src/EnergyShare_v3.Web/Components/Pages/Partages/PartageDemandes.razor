@page "/partages/{Id:guid}/demandes"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Mediator
@using EnergyShare_v3.Application.Features.Partage
@using EnergyShare_v3.Domain.Enums

@inject ISender Sender

<PageTitle>Demandes GRD</PageTitle>

<div class="page-shell py-4">

    <h3>Demandes GRD</h3>

    <p class="page-subtitle mb-4">
        Consultez et effectuez les démarches administratives liées à votre partage d’énergie.
    </p>

    @* =========================================================
       ETAT DE CHARGEMENT
       ========================================================= *@
    @if (isLoading)
    {
        <p>Chargement...</p>
    }

    @* =========================================================
       ERREUR GENERALE
       ========================================================= *@
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-warning">
            @errorMessage
        </div>
    }

    @* =========================================================
       AFFICHAGE DU PARTAGE
       ========================================================= *@
    else if (partage is not null)
    {
        @* ---------------------------------------------------------
           RAPPEL DU PARTAGE CONCERNE  :   Cette page ne concerne qu'un seul partage.L'utilisateur conserve ainsi 
           toujours le contexte du dossier sur lequel il effectue ses démarches GRD.
           --------------------------------------------------------- *@
        <div class="partage-card mb-4">

            <div class="partage-card-header">

                <div>
                    <h4 class="partage-card-title">
                        @partage.Nom
                    </h4>

                    <div class="partage-card-info mt-2">

                        <span>
                            <i class="bi bi-lightning-charge me-1"></i>

                            @(partage.EnergieType == PartageEnergieType.PairToPair
                                ? "Pair à pair"
                                : "Même bâtiment")
                        </span>

                        <span>
                            <i class="bi bi-people me-1"></i>
                            @partage.NombreParticipants participant(s)
                        </span>

                    </div>
                </div>

                @* Statut actuel du partage *@
                <span class="partage-status
                    @(partage.Statut == PartageEnergieStatutType.Actif
                        ? "partage-status-active"
                        : "partage-status-inactive")">

                    @GetStatutLabel(partage.Statut)
                </span>

            </div>
        </div>


        @* =========================================================
           ACTIONS DISPONIBLES AUPRES DU GRD

           Deux démarches existent actuellement :
           1. demander le périmètre électrique ;
           2. demander la validation du partage.

           Plus tard, cette zone pourra également proposer :
           - déclarer une modification du partage au GRD.
           ========================================================= *@
        <div class="card mb-4">

            <div class="card-header fw-bold">
                Nouvelle demande
            </div>

            <div class="card-body">

                <p class="text-muted">
                    Sélectionnez la démarche que vous souhaitez effectuer auprès du GRD.
                </p>

                <div class="d-flex flex-wrap gap-2">

                    @* =====================================================
                       DEMANDE D'INFORMATION DE PERIMETRE

                       Désactivée si :
                       - l'utilisateur ne peut pas modifier le partage ;
                       - le partage ne possède pas encore 2 participants ;
                       - une demande est en cours d'envoi ;
                       - une demande de périmètre est déjà en attente.
                       ===================================================== *@
                    <button class="btn btn-energy-action"
                            @onclick="HandleDemandePerimetre"
                            disabled="@(!partage.CanEdit || partage.NombreParticipants < 2 
                                        || isPerimetreLoading || HasDemandePerimetreEnAttente)">

                        <span class="bi bi-info-circle me-1"></span>

                        @(isPerimetreLoading
                            ? "Envoi..."
                            : "Demander info périmètre")
                    </button>

                   

                    @* =====================================================
                       DEMANDE DE VALIDATION DU PARTAGE

                       Désactivée si :
                       - l'utilisateur ne peut pas modifier ;
                       - moins de 2 participants ;
                       - une demande est déjà en cours d'envoi ;
                       - le partage est déjà en attente de validation.
                       ===================================================== *@
                    @* <button class="btn btn-energy-success"
                            @onclick="HandleDemandeValidation"
                            disabled="@(!partage.CanEdit || partage.NombreParticipants < 2  || isValidationLoading
                                        || partage.Statut == PartageEnergieStatutType.EnAttenteValidation)">

                        <span class="bi bi-check-circle-fill me-1"></span>

                        @GetValidationButtonLabel()
                    </button> *@
                    @* Validation initiale uniquement pour un partage encore inactif *@
                    @if (partage.Statut == PartageEnergieStatutType.Inactif)
                    {
                        <button class="btn btn-energy-success"
                                @onclick="HandleDemandeValidation"
                                disabled="@(!partage.CanEdit || partage.NombreParticipants < 2 || isValidationLoading)">

                            <span class="bi bi-check-circle-fill me-1"></span>

                            @GetValidationButtonLabel()
                        </button>
                    }

                    @* =====================================================
                       DEMANDE DE MODIFICATION DU PARTAGE

                       Une demande de modification peut être envoyée :
                       - lorsque le partage est actif ;
                       - lorsqu'il est suspendu après un refus du GRD.

                       Dans le second cas, l'utilisateur peut corriger son
                       partage puis soumettre à nouveau sa situation au GRD.
                       ===================================================== *@

                    @if (partage.Statut == PartageEnergieStatutType.Actif
                        || partage.Statut == PartageEnergieStatutType.Suspendu)
                    {
                        <button class="btn btn-energy-action"
                                @onclick="HandleDemandeModification"
                                disabled="@isModificationLoading">

                            <span class="bi bi-pencil-square me-1"></span>

                            @if (isModificationLoading)
                            {
                                <span>Envoi...</span>
                            }
                            else if (partage.Statut == PartageEnergieStatutType.Suspendu)
                            {
                                <span>Soumettre à nouveau au GRD</span>
                            }
                            else
                            {
                                <span>Déclarer les modifications au GRD</span>
                            }
                        </button>
                    }

                    @* =====================================================
                       PARTAGE SUSPENDU

                       Le GRD a refusé la précédente demande.L'utilisateur peut 
                       corriger son partage puis soumettre une nouvelle demande.
                       ===================================================== *@

                    @if (partage.Statut == PartageEnergieStatutType.Suspendu)
                    {
                        <div class="alert alert-info mt-3 mb-0 w-100">
                            <i class="bi bi-info-circle me-1"></i>

                            La précédente demande de modification a été refusée par le GRD.
                            Vous pouvez corriger le partage puis soumettre à nouveau les modifications.
                        </div>
                    }
                    
                   @* =========================================================
                       DEMANDE DE MODIFICATION EN COURS

                       Une fois la déclaration transmise au GRD,le partage passe en statut EnAttenteModification.
                       ========================================================= *@

                    @if (partage.Statut == PartageEnergieStatutType.EnAttenteModification)
                    {
                        <div class="alert alert-info mt-3 mb-0 w-100">

                            <i class="bi bi-hourglass-split me-1"></i>

                            Une déclaration de modification est actuellement
                            en attente de traitement par le GRD.
                        </div>
                    }
                
                </div>
               
               
                
                @* Message affiché lorsqu'une demande de périmètre est déjà en cours *@
                @if (HasDemandePerimetreEnAttente)
                {
                    <div class="alert alert-info mt-3 mb-0 w-100">
                        Une demande d’information de périmètre est déjà en attente de traitement par le GRD.
                    </div>
                }

               

                @* -----------------------------------------------------
                   Informations utiles lorsque les actions sont bloquées.
                   ----------------------------------------------------- *@
                @if (partage.NombreParticipants < 2)
                {
                    <div class="alert alert-info mt-3 mb-0">
                        Le partage doit compter au minimum deux participants avant de pouvoir effectuer une demande auprès du GRD.
                    </div>
                }

                @if (!partage.CanEdit)
                {
                    <div class="alert alert-info mt-3 mb-0">
                        Vous consultez les demandes de ce partage en lecture seule.
                    </div>
                }
            </div>
        </div>

        @* =========================================================
           MESSAGE D'ERREUR - DEMANDE DE PERIMETRE
           ========================================================= *@
        @if (!string.IsNullOrWhiteSpace(perimetreError))
        {
            <div class="alert alert-warning">
                @perimetreError
            </div>
        }

        @* =========================================================
           MESSAGE D'ERREUR - DEMANDE DE VALIDATION
           ========================================================= *@
        @if (!string.IsNullOrWhiteSpace(validationError))
        {
            <div class="alert alert-warning">
                @validationError
            </div>
        }

        @* =========================================================
           MESSAGE D'ERREUR - DEMANDE DE MODIFICATION
           ========================================================= *@
        @if (!string.IsNullOrWhiteSpace(modificationError))
        {
            <div class="alert alert-warning">
                @modificationError
            </div>
        }
        @* =========================================================
           DERNIERE DEMANDE D'INFORMATION DE PERIMETRE

           Pour l'instant, GetPartageById fournit uniquement la dernière demande de périmètre.

           TODO : prévoir plus tard une Query spécifique permettant de récupérer l'historique complet des demandes du partage.
           ========================================================= *@
      
           
           
       <div class="card mb-4">

            <div class="card-header fw-bold">
                Demande d’information de périmètre
            </div>

            <div class="card-body">

                @if (demandePerimetre is null)
                {
                    <p class="text-muted mb-0">
                        Aucune demande d’information de périmètre n’a encore été effectuée pour ce partage.
                    </p>
                }
                else
                {
                    <p class="text-muted">
                        Dernière demande enregistrée auprès du GRD.
                    </p>

                    <div class="metadata-box mb-3">

                        <div>
                            <span class="metadata-label">
                                Statut :
                            </span>

                            <span>
                                @demandePerimetre.ResponseStatus
                            </span>
                        </div>

                        <div>
                            <span class="metadata-label">
                                Date de demande :
                            </span>

                            <span>
                                @FormatDateTime(demandePerimetre.DateDemande)
                            </span>
                        </div>

                        @* -------------------------------------------------
                           PERIMETRE CONFIRME PAR LE GRD
                           ------------------------------------------------- *@
                        @if (demandePerimetre.PerimetreConfirme is not null)
                        {
                            <div>
                                <span class="metadata-label">
                                    Périmètre confirmé :
                                </span>

                                <span class="badge bg-success">
                                    @demandePerimetre.PerimetreConfirme
                                </span>
                            </div>
                        }

                        @* -------------------------------------------------
                           COMMENTAIRE DU GRD
                           ------------------------------------------------- *@
                        @if (!string.IsNullOrWhiteSpace(
                            demandePerimetre.CommentaireReponseGRD))
                        {
                            <div>
                                <span class="metadata-label">
                                    Commentaire du GRD :
                                </span>

                                <span>
                                    @demandePerimetre.CommentaireReponseGRD
                                </span>
                            </div>
                        }

                    </div>


                    @* -------------------------------------------------
                       DETAILS TRANSMIS AU GRD

                       Le champ est volontairement en lecture seule : il représente le contenu envoyé lors de la demande.
                       ------------------------------------------------- *@
                    <label class="form-label">
                        Détails transmis au GRD
                    </label>

                    <textarea class="form-control"
                              rows="5"
                              readonly>@demandePerimetre.DetailsDemande</textarea>
                }

            </div>
        </div>

        @* =========================================================
           DEMANDE DE VALIDATION DU PARTAGE

           Pour l'instant, le backend retourne le DTO après l'envoi, mais GetPartageById ne semble pas fournir l'historique
           complet des demandes de validation.

           Cette zone affiche donc :
           - l'état général du partage ;
           - la demande envoyée pendant la session courante si disponible.

           TODO :  créer plus tard une Query dédiée permettant d'afficher toutes les demandes de validation du partage.
           ========================================================= *@
        <div class="card mb-4">

            <div class="card-header fw-bold">
                Validation du partage
            </div>

            <div class="card-body">

                @if (partage.Statut == PartageEnergieStatutType.EnAttenteValidation)
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-hourglass-split me-1"></i>
                        Une demande de validation est actuellement
                        en attente de traitement par le GRD.
                    </div>
                }
                else if (partage.Statut == PartageEnergieStatutType.Actif)
                {
                    <div class="alert alert-success mb-0">
                        <i class="bi bi-check-circle me-1"></i>
                        Ce partage est actuellement actif.
                    </div>
                }
                else if (demandeValidation is not null)
                {
                    <div class="alert alert-success mb-0">
                        La demande de validation a été envoyée au GRD.
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">
                        Aucune demande de validation en cours
                        n’est disponible dans cette vue.
                    </p>
                }

            </div>
        </div>


        @* =========================================================
   HISTORIQUE DES DEMANDES GRD

   Cette section affiche toutes les démarches liées au partage :
   - demande d'information de périmètre ;
   - validation initiale ;
   - modification d'un partage actif ;
   - plus tard : clôture.

   Les demandes les plus récentes sont affichées en premier.
   ========================================================= *@

        <div class="card">

            <div class="card-header fw-bold">
                Historique des demandes
            </div>

            <div class="card-body">

                @if (!historiqueDemandes.Any())
                {
                    <p class="text-muted mb-0">
                        Aucune demande GRD n’a encore été enregistrée pour ce partage.
                    </p>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Statut</th>
                                    <th>Réponse GRD</th>
                                    <th>Détails</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var demande in historiqueDemandes)
                                {
                                    <tr>

                                        @* Date d'introduction de la demande *@
                                        <td>
                                            @FormatDateTime(demande.DateDemande)
                                        </td>

                                        @* Type de démarche *@
                                        <td>
                                            @GetDemandeTypeLabel(demande.DemandeType)
                                        </td>

                                        @* Etat actuel de la demande *@
                                        <td>
                                            @demande.ResponseStatus
                                        </td>

                                        @* Commentaire du GRD.
                                   C'est notamment ici que l'utilisateur
                                   peut comprendre pourquoi une modification
                                   a été refusée. *@
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(
                                                demande.CommentaireReponseGRD))
                                            {
                                                @demande.CommentaireReponseGRD
                                            }
                                            else if (demande.ResponseStatus ==
                                                     DdeGRDResponseStatus.EnAttente)
                                            {
                                                <span class="text-muted">
                                                    En attente de réponse
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Aucun commentaire
                                                </span>
                                            }
                                        </td>

                                        @* Pour le MVP, on affiche les détails
                                   directement dans un élément repliable.
                                   Pas besoin de créer une nouvelle page. *@
                                        <td>
                                            <details>
                                                <summary class="text-primary">
                                                    Voir
                                                </summary>

                                                <pre class="mt-2 mb-0 text-wrap">
@demande.DetailsDemande
                                        </pre>
                                            </details>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>
        </div>
    }

</div>


@code {

    [Parameter]
    public Guid Id { get; set; }

    // =========================================================
    // DONNEES GENERALES DE LA PAGE
    // =========================================================

    private PartageDetailsDto? partage; // Partage actuellement consulté.
    private bool isLoading = true; // Etat de chargement initial.
    private string? errorMessage;  // Message d'erreur lors du chargement du partage.

    // =========================================================
    // DEMANDE D'INFORMATION DE PERIMETRE
    // =========================================================
    private DemandePerimetreDto? demandePerimetre; // Dernière demande de périmètre connue pour ce partage.
    private string? perimetreError;  // Message d'erreur éventuel.
    private bool isPerimetreLoading;    // Permet d'éviter plusieurs envois simultanés.
    // Une nouvelle demande ne peut pas être envoyée tant que la précédente est encore en attente.
    private bool HasDemandePerimetreEnAttente =>     
        demandePerimetre?.ResponseStatus == "EnAttente";

    // =========================================================
    // DEMANDE DE VALIDATION DU PARTAGE
    // =========================================================
    private DemandeValidationPartageDto? demandeValidation;  // DTO retourné lorsqu'une nouvelle demande de validation est envoyée.
    private string? validationError;  // Message d'erreur éventuel.
    private bool isValidationLoading;   // Permet d'éviter plusieurs clics pendant l'envoi.
     
    // =========================================================
     // DEMANDE DE MODIFICATION DU PARTAGE
     // =========================================================
    private DemandeModificationPartageDto? demandeModification;
    private string? modificationError;
    private bool isModificationLoading;

    // =========================================================
    // Historique complet des demandes GRD du partage.
    // =========================================================
    private IReadOnlyList<HistoriqueDemandeGrdDto> historiqueDemandes = [];

    // Charge les informations du partage ainsi quesa dernière demande de périmètre éventuelle
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = null;

        var result = await Sender.Send(
            new GetPartageById(Id));

        if (!result.IsSuccess)
        {
            errorMessage = "Impossible de charger les demandes du partage.";

            isLoading = false;
            return;
        }

        partage = result.Value;

        // GetPartageById expose actuellement la dernière demande de périmètre.
        demandePerimetre =  partage.DerniereDemandePerimetre;

        // Chargement de l'historique complet des démarches GRD.
        var historiqueResult = await Sender.Send(new GetHistoriqueDemandesGrdPartage(Id));

        if (historiqueResult.IsSuccess)
        {
            historiqueDemandes = historiqueResult.Value;
        }

        isLoading = false;
    }

    /// <summary>
    /// Envoie une demande d'information de périmètre au GRD. Les données nécessaires sont préparées par la couche Application.
    /// <summary>
    private async Task HandleDemandePerimetre()
    {
        if (partage is null)
            return;

        perimetreError = null;
        isPerimetreLoading = true;

        var result = await Sender.Send(
            new DemandeInfoPerimetrePartage(partage.Id));

        isPerimetreLoading = false;

        if (!result.IsSuccess)
        {
            perimetreError = "Impossible d’envoyer la demande d’information de périmètre.";

            return;
        }
        // Le DTO retourné devient directement la dernière demande affichée dans la page.
        demandePerimetre = result.Value;
    }

    /// <summary>
    /// Envoie le dossier de partage au GRD pour validation.
    /// </summary>
    private async Task HandleDemandeValidation()
    {
        if (partage is null)
            return;

        validationError = null;
        isValidationLoading = true;

        var result = await Sender.Send(
            new DemandeValidationPartage(partage.Id));

        isValidationLoading = false;

        if (!result.IsSuccess)
        {
            validationError = "Impossible d’envoyer la demande de validation GRD.";

            return;
        }

        // Conservation du DTO retourné.
        demandeValidation = result.Value;

        // Recharge du partage afin de récupérer le nouveau statut. Ex : Inactif -> EnAttenteValidation.
        var refresh = await Sender.Send(
            new GetPartageById(Id));

        if (refresh.IsSuccess)
        {
            partage = refresh.Value;
            demandePerimetre = partage.DerniereDemandePerimetre;// On resynchronise également la dernière demande de périmètre.
        }
    }

    /// <summary>
    /// Retourne le texte du bouton de validation selon l'état actuel du partage.
    /// </summary>
    private string GetValidationButtonLabel()
    {
        if (isValidationLoading)
            return "Envoi...";

        if (partage?.Statut ==
            PartageEnergieStatutType.EnAttenteValidation)
        {
            return "Validation GRD en cours...";
        }

        return "Demander validation GRD";
    }

    /// <summary>
    /// Affiche un libellé compréhensible pour le statut métier.
    /// </summary>
    private static string GetStatutLabel(
        PartageEnergieStatutType statut)
    {
        return statut switch
        {
            PartageEnergieStatutType.Inactif => "Brouillon / Inactif",
            PartageEnergieStatutType.EnAttenteValidation =>  "En attente GRD",
            PartageEnergieStatutType.Actif =>  "Actif",
            PartageEnergieStatutType.EnAttenteModification => "Modification en attente",
            PartageEnergieStatutType.Suspendu => "Suspendu",
            PartageEnergieStatutType.EnCoursCloture =>  "Clôture en cours",
            PartageEnergieStatutType.Cloture =>  "Clôturé",

            _ => statut.ToString()
        };
    }

    /// <summary>
    /// Affiche les dates en heure locale de Bruxelles
    /// selon le comportement actuellement utilisé dans l'application.
    /// </summary>
    private static string FormatDateTime(DateTime? date)
        => date?.ToLocalTime()
               .ToString("dd/MM/yyyy HH:mm")
           ?? "Non définie";

    /// <summary>
    /// Déclare au GRD les modifications apportées à un partage déjà actif.
    /// </summary>
    private async Task HandleDemandeModification()
    {
        if (partage is null)
            return;

        modificationError = null;
        isModificationLoading = true;

        var result = await Sender.Send(
            new DemandeModificationPartage(partage.Id));

        isModificationLoading = false;

        if (!result.IsSuccess)
        {
            modificationError =
                "Impossible d’envoyer la demande de modification au GRD.";

            return;
        }

        demandeModification = result.Value;

        // Recharge le partage afin d'afficher immédiatement le nouveau statut EnAttenteModification.
        var refresh = await Sender.Send(
            new GetPartageById(Id));

        if (refresh.IsSuccess)
        {
            partage = refresh.Value;
            demandePerimetre =
                partage.DerniereDemandePerimetre;
        }
    }
    /// <summary>
    /// Transforme le type  de la demande  en libellé lisible pour l'utilisateur.
    /// </summary>
    private static string GetDemandeTypeLabel(DemandeGRDType type)
    {
        return type switch
        {
            DemandeGRDType.DdeInfoPerimetre => "Information périmètre",
            DemandeGRDType.NouvelleActivation => "Validation initiale",
            DemandeGRDType.ModificationPartageExistant => "Modification du partage",
            DemandeGRDType.CloturePartageExistant => "Clôture du partage",

            _ => type.ToString()
        };
    }

}