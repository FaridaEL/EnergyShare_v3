@page "/organisme-public/demandes-grd"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "OrganismePublic,Administrateur")]

@using Microsoft.AspNetCore.Authorization
@using Mediator
@using EnergyShare_v3.Application.Features.Partage
@using EnergyShare_v3.Domain.Enums

@inject ISender Sender

<PageTitle>Demandes GRD</PageTitle>

<h3>Demandes GRD en attente</h3>

<p class="text-muted">
    Consultez les demandes d'information de périmètre envoyées par les créateurs de partage.
</p>

@if (isLoading)
{
    <p>Chargement...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning">@errorMessage</div>
}
else if (!demandes.Any())
{
    <div class="alert alert-info">
        Aucune demande GRD en attente.
    </div>
}
else
{
    <div class="card">
        <div class="card-header fw-bold">
            Demandes à traiter
        </div>

        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Partage</th>
                        <th>Type</th>
                        <th>Statut</th>
                        <th>Détails</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var demande in demandes)
                    {
                        <tr>
                            <td>@FormatDateTime(demande.DateDemande)</td>

                            <td>
                                @if (demande.PartageId is not null)
                                {
                                    <a href="@($"/partages/{demande.PartageId}")">
                                        @(demande.NomPartage ?? "Partage")
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Non lié</span>
                                }
                            </td>

                            <td>@GetDemandeTypeLabel(demande.DemandeType)</td>

                            <td>
                                <span class="badge bg-warning text-dark">
                                    @demande.ResponseStatus
                                </span>
                            </td>

                            <td>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ToggleDetails(demande.Id)">
                                    Voir détails
                                </button>
                            </td>

                            <td class="text-end">
                                <button class="btn btn-sm btn-primary" disabled>
                                    Répondre
                                </button>
                            </td>
                        </tr>

                        @if (selectedDemandeId == demande.Id)
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="p-3 bg-light rounded">
                                        <strong>Détails transmis :</strong>

                                        <pre class="mt-2 mb-0">@demande.DetailsDemande</pre>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string? errorMessage;

    // Liste des demandes GRD en attente récupérées via le handler.
    private IReadOnlyList<DemandeGrdDto> demandes = [];

    // Permet d'afficher/masquer les détails d'une demande dans le tableau.
    private Guid? selectedDemandeId;

    protected override async Task OnInitializedAsync()
    {
        var result = await Sender.Send(new GetDemandesGrdEnAttente());

        if (!result.IsSuccess)
        {
            errorMessage = "Impossible de charger les demandes GRD.";
            isLoading = false;
            return;
        }

        demandes = result.Value;
        isLoading = false;
    }

    private void ToggleDetails(Guid demandeId)
    {
        selectedDemandeId = selectedDemandeId == demandeId
            ? null
            : demandeId;
    }

    private static string FormatDateTime(DateTime date)
        => date.ToLocalTime().ToString("dd/MM/yyyy HH:mm");

    private static string GetDemandeTypeLabel(DemandeGRDType type)
    {
        return type switch
        {
            DemandeGRDType.DdeInfoPerimetre => "Information périmètre",
            _ => type.ToString()
        };
    }
}
