@inject IJSRuntime JS

<div class="network-status @(IsOnline ? "online" : "offline")">
    @(IsOnline ? "🟢 En ligne" : "🔴 Hors connexion")
</div>

@code {
    private bool IsOnline = true;

    private DotNetObjectReference<NetworkStatus>? objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync("networkStatus.register", objRef);
        }
    }

    [JSInvokable]
    public void UpdateNetworkStatus(bool isOnline)
    {
        IsOnline = isOnline;
        StateHasChanged();
    }
}